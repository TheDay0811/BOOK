@{
    ViewData["Title"] = "Trạng thái Cơ sở dữ liệu MongoDB NoSQL";
    var auditLogs = ViewBag.AuditLogs as List<BOOK.Models.MongoEntities.SystemAuditLog> ?? new();
    var chatLogs = ViewBag.ChatLogs as List<BOOK.Models.MongoEntities.ChatHistoryLog> ?? new();
    string dbName = ViewBag.DatabaseName ?? "LibraryDB";
    string connStr = ViewBag.ConnectionString ?? "mongodb://127.0.0.1:27017";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header Banner -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-6 mb-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        MongoDB Active & Running
                    </span>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 border border-blue-200">
                        NoSQL Document Store
                    </span>
                </div>
                <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Trạng thái Cơ sở Dữ liệu MongoDB</h1>
                <p class="text-sm text-slate-500 mt-1">
                    Hệ thống áp dụng kiến trúc <strong>Polyglot Persistence</strong>: Lưu trữ Nhật ký kiểm toán hệ thống và Lịch sử hội thoại Chatbot AI trên MongoDB.
                </p>
            </div>
            <div>
                <a href="/" class="inline-flex items-center gap-2 px-4 py-2 bg-navy-800 hover:bg-navy-900 text-white rounded-xl text-sm font-semibold transition-all shadow-sm">
                    <i data-lucide="home" class="w-4 h-4"></i> Về Trang chủ
                </a>
            </div>
        </div>
    </div>

    <!-- MongoDB Connection Info Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-blue-50 text-navy-800 flex items-center justify-center">
                    <i data-lucide="database" class="w-5 h-5"></i>
                </div>
                <div>
                    <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Cơ sở dữ liệu</div>
                    <div class="text-xl font-bold text-slate-900">@dbName</div>
                </div>
            </div>
            <p class="text-xs text-slate-500 mt-2">MongoDB Engine: v8.0.x (x86_64 portable)</p>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                    <i data-lucide="layers" class="w-5 h-5"></i>
                </div>
                <div>
                    <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Collections Đang Hoạt Động</div>
                    <div class="text-xl font-bold text-emerald-600">2 Collections</div>
                </div>
            </div>
            <p class="text-xs text-slate-500 mt-2">system_audit_logs, chat_history_logs</p>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                    <i data-lucide="terminal" class="w-5 h-5"></i>
                </div>
                <div>
                    <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">URI Kết Nối (Compass)</div>
                    <code class="text-xs font-mono font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200 select-all">@connStr</code>
                </div>
            </div>
            <p class="text-xs text-slate-500 mt-2">Dán chuỗi này vào MongoDB Compass để mở GUI</p>
        </div>
    </div>

    <!-- Section 1: System Audit Logs -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden mb-8">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
            <div class="flex items-center gap-2">
                <i data-lucide="shield-check" class="w-5 h-5 text-navy-800"></i>
                <h3 class="font-bold text-slate-900">Collection: system_audit_logs (@auditLogs.Count bản ghi)</h3>
            </div>
            <span class="text-xs text-slate-400 font-mono">BSON Document Format</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50 text-xs uppercase font-semibold text-slate-500 border-b border-slate-100">
                    <tr>
                        <th class="px-6 py-3">MongoDB _id (ObjectId)</th>
                        <th class="px-6 py-3">Hành động</th>
                        <th class="px-6 py-3">Tài khoản</th>
                        <th class="px-6 py-3">Vai trò</th>
                        <th class="px-6 py-3">Chi tiết sự kiện</th>
                        <th class="px-6 py-3">Thời gian (UTC)</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (auditLogs.Any())
                    {
                        @foreach (var log in auditLogs)
                        {
                            <tr class="hover:bg-slate-50/60 transition-colors">
                                <td class="px-6 py-4 font-mono text-xs text-blue-600 font-semibold select-all">@log.Id</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-navy-100 text-navy-800">
                                        @log.Action
                                    </span>
                                </td>
                                <td class="px-6 py-4 font-semibold text-slate-900">@log.Username</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700">
                                        @log.UserRole
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-slate-700">@log.Details</td>
                                <td class="px-6 py-4 text-xs text-slate-400 whitespace-nowrap font-mono">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-8 text-center text-slate-400">Chưa có bản ghi nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Section 2: Chat History Logs -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
            <div class="flex items-center gap-2">
                <i data-lucide="bot" class="w-5 h-5 text-emerald-600"></i>
                <h3 class="font-bold text-slate-900">Collection: chat_history_logs (@chatLogs.Count cuộc hội thoại AI)</h3>
            </div>
            <span class="text-xs text-slate-400 font-mono">Unstructured AI Telemetry</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50 text-xs uppercase font-semibold text-slate-500 border-b border-slate-100">
                    <tr>
                        <th class="px-6 py-3">MongoDB _id</th>
                        <th class="px-6 py-3">Người hỏi</th>
                        <th class="px-6 py-3">Câu hỏi Bạn đọc</th>
                        <th class="px-6 py-3">Phản hồi của Thủ thư AI</th>
                        <th class="px-6 py-3">Model</th>
                        <th class="px-6 py-3">Thời gian</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (chatLogs.Any())
                    {
                        @foreach (var c in chatLogs)
                        {
                            <tr class="hover:bg-slate-50/60 transition-colors">
                                <td class="px-6 py-4 font-mono text-xs text-emerald-600 font-semibold select-all">@c.Id</td>
                                <td class="px-6 py-4 font-semibold text-slate-900 whitespace-nowrap">@c.Username</td>
                                <td class="px-6 py-4 text-slate-900 font-medium">@c.UserPrompt</td>
                                <td class="px-6 py-4 text-slate-600 text-xs max-w-md">@c.BotResponse</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
                                        @c.ModelUsed
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-xs text-slate-400 whitespace-nowrap font-mono">@c.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-8 text-center text-slate-400">Chưa có hội thoại nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    // Khởi tạo Lucide icons
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
</script>
