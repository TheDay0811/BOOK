        </a>

        <a asp-controller="Book" asp-action="Index" class="group bg-white p-5 rounded-2xl border border-slate-200 hover:border-navy-800 shadow-sm hover:shadow-md transition-all text-center flex flex-col items-center">
            <div class="w-12 h-12 rounded-xl bg-cyan-50 text-cyan-700 flex items-center justify-center group-hover:scale-110 transition-transform mb-3">
