@model BOOK.Models.ViewModels.BookListViewModel
@{
    ViewData["Title"] = "Danh Mục & Tra Cứu Tài Liệu";
}

<!-- HEADER BANNER & BREADCRUMB -->
<div class="bg-gradient-to-r from-navy-900 via-navy-800 to-navy-900 text-white py-10 border-b border-navy-700 shadow-inner">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs text-slate-300 mb-3">
            <a asp-controller="Home" asp-action="Index" class="hover:text-amber-400 transition-colors flex items-center gap-1">
                <i data-lucide="home" class="w-3.5 h-3.5"></i> Trang chủ
            </a>
            <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-slate-500"></i>
            <span class="text-amber-400 font-medium">Kho tài liệu & Sách</span>
        </nav>

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Tra Cứu Danh Mục Sách</h1>
                <p class="text-sm text-slate-300 mt-1">Khám phá hơn 50.000 đầu sách in, giáo trình và tài liệu nghiên cứu chuyên ngành.</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-navy-950/60 border border-navy-700 text-xs text-slate-200">
                    <i data-lucide="layers" class="w-4 h-4 text-blue-400"></i> Tổng số: <strong>@Model.TotalItems</strong> đầu sách
                </span>
            </div>
        </div>
    </div>
</div>

<!-- MAIN SEARCH & FILTER CONTENT -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">

        <!-- LEFT SIDEBAR: MULTI-FACETED FILTER -->
        <aside class="lg:col-span-1">
            <form asp-controller="Book" asp-action="Index" method="get" id="filterForm" 
                  class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-6 sticky top-28">
                
                <!-- Header Filter -->
                <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                    <h3 class="font-bold text-slate-900 flex items-center gap-2 text-base">
                        <i data-lucide="sliders-horizontal" class="w-5 h-5 text-navy-800"></i>
                        Bộ Lọc Tìm Kiếm
                    </h3>
                    <a asp-controller="Book" asp-action="Index" class="text-xs font-semibold text-rose-600 hover:text-rose-700 transition-colors">
                        Xóa tất cả
                    </a>
                </div>

                <!-- Keyword Search Field -->
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">Từ khóa tìm kiếm</label>
                    <div class="relative">
                        <input type="text" asp-for="SearchQuery" placeholder="Tên sách, tác giả, ISBN..."
                               class="w-full pl-9 pr-3 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-navy-800 focus:ring-1 focus:ring-navy-800 focus:outline-none" />
                        <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-2.5"></i>
                    </div>
                </div>

                <!-- Categories Checkbox Filter -->
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2.5">Chuyên ngành / Thể loại</label>
                    <div class="space-y-2 max-h-48 overflow-y-auto pr-1">
                        @if (Model.Categories != null && Model.Categories.Any())
                        {
                            foreach (var cat in Model.Categories)
                            {
                                var isChecked = Model.SelectedCategoryIds.Contains(int.Parse(cat.Value));
                                <label class="flex items-center justify-between text-sm text-slate-700 hover:text-navy-800 cursor-pointer select-none">
                                    <span class="flex items-center gap-2">
                                        <input type="checkbox" name="SelectedCategoryIds" value="@cat.Value" @(isChecked ? "checked" : "")
                                               class="w-4 h-4 text-navy-800 rounded border-slate-300 focus:ring-navy-800" />
                                        <span>@cat.Text</span>
                                    </span>
                                </label>
                            }
                        }
                    </div>
                </div>

                <!-- Availability Status Filter (Radio) -->
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2.5">Tình trạng trong kho</label>
                    <div class="space-y-2 text-sm">
                        <label class="flex items-center gap-2 text-slate-700 cursor-pointer">
                            <input type="radio" asp-for="AvailabilityFilter" value="all" 
                                   class="w-4 h-4 text-navy-800 border-slate-300 focus:ring-navy-800" />
                            <span>Tất cả trạng thái</span>
                        </label>
                        <label class="flex items-center gap-2 text-slate-700 cursor-pointer">
                            <input type="radio" asp-for="AvailabilityFilter" value="available" 
                                   class="w-4 h-4 text-emerald-600 border-slate-300 focus:ring-emerald-600" />
                            <span class="flex items-center gap-1 text-emerald-700 font-medium">
                                <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Còn sách sẵn sàng
                            </span>
                        </label>
                        <label class="flex items-center gap-2 text-slate-700 cursor-pointer">
                            <input type="radio" asp-for="AvailabilityFilter" value="out_of_stock" 
                                   class="w-4 h-4 text-rose-600 border-slate-300 focus:ring-rose-600" />
                            <span class="text-slate-500">Tạm thời hết sách</span>
                        </label>
                    </div>
                </div>

                <!-- Action Button -->
                <div class="pt-2 border-t border-slate-100 flex flex-col gap-2">
                    <button type="submit" 
                            class="w-full py-2.5 bg-navy-800 hover:bg-navy-900 text-white rounded-xl text-sm font-bold shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2">
                        <i data-lucide="filter" class="w-4 h-4"></i> Áp Dụng Bộ Lọc
                    </button>
                </div>
            </form>
        </aside>

        <!-- RIGHT CONTENT: BOOK GRID & SORT CONTROLS -->
        <main class="lg:col-span-3 space-y-6">

            <!-- Control Bar (Results Count & Sort Select) -->
            <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="text-sm text-slate-600">
                    Hiển thị <span class="font-bold text-slate-900">@Model.Books.Count</span> trên tổng số <span class="font-bold text-slate-900">@Model.TotalItems</span> kết quả
                </div>

                <div class="flex items-center gap-3 w-full sm:w-auto">
                    <label for="sortBy" class="text-xs font-semibold text-slate-500 whitespace-nowrap">Sắp xếp theo:</label>
                    <select id="sortBy" name="SortBy" form="filterForm" onchange="document.getElementById('filterForm').submit();"
                            class="py-1.5 pl-3 pr-8 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-navy-800 focus:ring-1 focus:ring-navy-800">
                        <option value="newest" selected="@(Model.SortBy == "newest")">Sách mới nhất</option>
                        <option value="popular" selected="@(Model.SortBy == "popular")">Mượn nhiều nhất</option>
                        <option value="rating_desc" selected="@(Model.SortBy == "rating_desc")">Đánh giá cao nhất</option>
                        <option value="title_asc" selected="@(Model.SortBy == "title_asc")">Tên sách (A - Z)</option>
                    </select>
                </div>
            </div>

            <!-- BOOK CARDS GRID -->
            @if (Model.Books != null && Model.Books.Any())
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
                    @foreach (var book in Model.Books)
                    {
                        <div class="group bg-white rounded-2xl border border-slate-200 hover:border-navy-800/30 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden">
                            <!-- Book Cover Image Section -->
                            <div class="relative h-64 overflow-hidden bg-slate-100 flex items-center justify-center p-4">
                                <img src="@(string.IsNullOrEmpty(book.CoverImageUrl) ? "/uploads/books/default-book.svg" : book.CoverImageUrl)" alt="@book.Title" 
                                     class="h-full max-w-full object-contain rounded-lg shadow group-hover:scale-105 transition-transform duration-300"
                                     onerror="this.onerror=null; this.src='/uploads/books/default-book.svg';" />

                                <!-- Availability Badge -->
                                <div class="absolute top-3 right-3">
                                    @if (book.IsAvailable)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 shadow-sm border border-emerald-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Còn @book.AvailableCopies cuốn
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-200 text-slate-600 shadow-sm">
                                            <i data-lucide="clock-alert" class="w-3.5 h-3.5"></i> Hết sách
                                        </span>
                                    }
                                </div>

                                <!-- Category Badge -->
                                <div class="absolute bottom-3 left-3">
                                    <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-navy-900/80 text-white backdrop-blur-sm">
                                        @book.CategoryName
                                    </span>
                                </div>
                            </div>

                            <!-- Book Details Info -->
                            <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
                                <div>
                                    <!-- Star rating & reviews -->
                                    <div class="flex items-center gap-1.5 text-xs text-amber-500 mb-1">
                                        <div class="flex items-center">
                                            <i data-lucide="star" class="w-3.5 h-3.5 fill-amber-400 text-amber-400"></i>
                                            <span class="ml-1 font-bold text-slate-800">@book.Rating.ToString("0.0")</span>
                                        </div>
                                        <span class="text-slate-400">(@book.ReviewCount đánh giá)</span>
                                    </div>

                                    <!-- Title -->
                                    <h4 class="font-bold text-slate-900 text-base line-clamp-2 leading-snug group-hover:text-navy-800 transition-colors">
                                        <a asp-controller="Book" asp-action="Details" asp-route-id="@book.Id">
                                            @book.Title
                                        </a>
                                    </h4>

                                    <!-- Author & Publisher -->
                                    <div class="mt-2 space-y-1 text-xs text-slate-500">
                                        <p class="flex items-center gap-1.5">
                                            <i data-lucide="user-pen" class="w-3.5 h-3.5 text-slate-400"></i>
                                            <span class="truncate">Tác giả: <strong class="text-slate-700">@book.Author</strong></span>
                                        </p>
                                        <p class="flex items-center gap-1.5">
                                            <i data-lucide="building-2" class="w-3.5 h-3.5 text-slate-400"></i>
                                            <span class="truncate">NXB: @book.PublisherName (@book.PublishYear)</span>
                                        </p>
                                    </div>

                                    <!-- Shelf Location Tag (Vị trí kệ sách) -->
                                    <div class="mt-3 inline-flex items-center gap-1 px-2 py-1 bg-blue-50 text-navy-800 rounded-md text-[11px] font-medium border border-blue-100">
                                        <i data-lucide="map-pin" class="w-3 h-3 text-blue-600"></i>
                                        Vị trí: @book.ShelfLocation
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="pt-3 border-t border-slate-100 flex items-center gap-2">
                                    <a asp-controller="Book" asp-action="Details" asp-route-id="@book.Id"
                                       class="flex-1 py-2 px-3 text-center text-xs font-bold text-navy-800 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors">
                                        Xem chi tiết
                                    </a>
                                    @if (book.IsAvailable)
                                    {
                                        <a asp-controller="Book" asp-action="Details" asp-route-id="@book.Id" asp-fragment="borrow"
                                           class="py-2 px-3 text-center text-xs font-bold text-white bg-navy-800 hover:bg-navy-700 rounded-xl transition-colors flex items-center gap-1 shadow-sm">
                                            <i data-lucide="bookmark-plus" class="w-3.5 h-3.5"></i> Mượn
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- PAGINATION BAR -->
                <div class="flex flex-col sm:flex-row justify-between items-center gap-4 pt-6 border-t border-slate-200">
                    <p class="text-xs text-slate-500">
                        Trang <span class="font-bold text-slate-800">@Model.CurrentPage</span> / @Model.TotalPages
                    </p>
                    
                    <nav class="flex items-center gap-1">
                        @if (Model.CurrentPage > 1)
                        {
                            <a asp-action="Index" asp-route-currentPage="@(Model.CurrentPage - 1)" asp-route-searchQuery="@Model.SearchQuery" asp-route-sortBy="@Model.SortBy"
                               class="p-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 text-slate-600 transition-colors">
                                <i data-lucide="chevron-left" class="w-4 h-4"></i>
                            </a>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <a asp-action="Index" asp-route-currentPage="@i" asp-route-searchQuery="@Model.SearchQuery" asp-route-sortBy="@Model.SortBy"
                               class="w-9 h-9 flex items-center justify-center rounded-lg text-sm font-semibold transition-all @(i == Model.CurrentPage ? "bg-navy-800 text-white shadow-sm" : "bg-white border border-slate-200 text-slate-700 hover:bg-slate-50")">
                                @i
                            </a>
                        }

                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a asp-action="Index" asp-route-currentPage="@(Model.CurrentPage + 1)" asp-route-searchQuery="@Model.SearchQuery" asp-route-sortBy="@Model.SortBy"
                               class="p-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 text-slate-600 transition-colors">
                                <i data-lucide="chevron-right" class="w-4 h-4"></i>
                            </a>
                        }
                    </nav>
                </div>
            }
            else
            {
                <!-- Empty Search Results State -->
                <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center space-y-4">
                    <div class="w-16 h-16 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto">
                        <i data-lucide="search-x" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-lg font-bold text-slate-800">Không tìm thấy tài liệu phù hợp</h3>
                    <p class="text-sm text-slate-500 max-w-md mx-auto">
                        Thử kiểm tra lại chính tả từ khóa, bỏ bớt các điều kiện lọc hoặc nhập mã ISBN để có kết quả chính xác nhất.
                    </p>
                    <a asp-controller="Book" asp-action="Index" 
                       class="inline-flex items-center gap-2 px-4 py-2 bg-navy-800 text-white rounded-xl text-sm font-semibold hover:bg-navy-700 transition-colors">
                        <i data-lucide="rotate-ccw" class="w-4 h-4"></i> Đặt lại bộ lọc
                    </a>
                </div>
            }

        </main>
    </div>
</div>
