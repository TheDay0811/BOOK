@model BOOK.Models.ViewModels.BookDetailsViewModel
@{
    ViewData["Title"] = Model.Book.Title;
    var userCardStatus = Model.UserCardStatus;
    var hasUnreturnedBooks = Model.HasUnreturnedBooks; // true when currentBorrowedCount >= 3
    var hasOverdueBooks = Model.HasOverdueBooks;
    var alreadyHoldingThisBook = Model.AlreadyHoldingThisBook;
    var currentBorrowedCount = Model.CurrentBorrowedCount;
    var maxAllowedBorrow = Math.Max(0, 3 - currentBorrowedCount);
    var isAuthenticated = Model.IsUserAuthenticated;
    var nextCopy = Model.Copies.FirstOrDefault(c => c.Status == "Còn");
    var canBorrow = isAuthenticated && Model.Book.IsAvailable && userCardStatus == "Sử dụng được" && !hasUnreturnedBooks && !hasOverdueBooks && !alreadyHoldingThisBook && currentBorrowedCount < 3;
}

<!-- BREADCRUMB -->
<div class="bg-slate-100 border-b border-slate-200 py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center gap-2 text-xs text-slate-500">
            <a asp-controller="Home" asp-action="Index" class="hover:text-navy-800 transition-colors flex items-center gap-1">
                <i data-lucide="home" class="w-3.5 h-3.5"></i> Trang chủ
            </a>
            <i data-lucide="chevron-right" class="w-3 h-3 text-slate-400"></i>
            <a asp-controller="Book" asp-action="Index" class="hover:text-navy-800 transition-colors">Danh mục tựa sách</a>
            <i data-lucide="chevron-right" class="w-3 h-3 text-slate-400"></i>
            <span class="text-navy-800 font-semibold truncate max-w-xs sm:max-w-md">@Model.Book.Title</span>
        </nav>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-10">

    <!-- KHUNG CHI TIẾT TỰA SÁCH & BẢN SAO VẬT LÝ -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 lg:p-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
            
            <!-- CỘT TRÁI: ẢNH BÌA & THẺ THÔNG TIN KHO -->
            <div class="lg:col-span-4 flex flex-col items-center">
                <div class="relative w-full max-w-[280px] aspect-[2/3] rounded-2xl overflow-hidden shadow-2xl border border-slate-200 bg-slate-100">
                    <img src="@(string.IsNullOrEmpty(Model.Book.CoverImageUrl) ? "/uploads/books/default-book.svg" : Model.Book.CoverImageUrl)" 
                         alt="@Model.Book.Title" 
                         class="w-full h-full object-cover" 
                         onerror="this.onerror=null; this.src='/uploads/books/default-book.svg';" />
                    <div class="absolute top-3 left-3">
                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-navy-950/80 text-white backdrop-blur-md">
                            Mã: @Model.Book.ISBN
                        </span>
                    </div>
                </div>

                <!-- Bảng Vị trí kệ sách -->
                <div class="w-full max-w-[280px] mt-6 p-4 rounded-2xl bg-blue-50/80 border border-blue-100 text-center">
                    <span class="text-xs font-semibold text-blue-700 uppercase tracking-wider block mb-1">Vị trí tại quầy lưu thông</span>
                    <p class="text-sm font-bold text-navy-900 flex items-center justify-center gap-1.5">
                        <i data-lucide="map-pin" class="w-4 h-4 text-blue-600"></i>
                        @Model.Book.ShelfLocation
                    </p>
                </div>
            </div>

            <!-- CỘT PHẢI: CHI TIẾT TỰA SÁCH & TÌNH TRẠNG CÁC CUỐN SÁCH -->
            <div class="lg:col-span-8 flex flex-col justify-between space-y-6">
                <div class="space-y-4">
                    <div class="flex flex-wrap items-center gap-3">
                        <span class="px-2.5 py-1 rounded-md text-xs font-bold text-navy-800 bg-blue-100">
                            @Model.Book.CategoryName
                        </span>
                        <span class="text-xs text-slate-500 font-mono">Mã tựa sách: <strong>@Model.Book.ISBN</strong></span>
                    </div>

                    <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight leading-tight">
                        @Model.Book.Title
                    </h1>

                    <!-- BẢNG THÔNG SỐ TỰA SÁCH (METADATA) -->
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs pt-1">
                        <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                            <span class="block text-[10px] font-semibold text-slate-400 uppercase">Tác giả</span>
                            <span class="font-bold text-slate-800 text-xs sm:text-sm">@Model.Book.Author</span>
                        </div>
                        <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                            <span class="block text-[10px] font-semibold text-slate-400 uppercase">Nhà xuất bản</span>
                            <span class="font-bold text-slate-800 text-xs sm:text-sm">@Model.Book.PublisherName</span>
                        </div>
                        <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                            <span class="block text-[10px] font-semibold text-slate-400 uppercase">Năm xuất bản</span>
                            <span class="font-bold text-slate-800 text-xs sm:text-sm">@Model.Book.PublishYear</span>
                        </div>
                    </div>

                    <!-- BẢNG TÌNH TRẠNG KHO: CÁC CUỐN SÁCH VẬT LÝ THẬT TỪ DATABASE -->
                    <div class="bg-slate-50 rounded-2xl p-5 border border-slate-200 space-y-3">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                            <h4 class="font-bold text-xs uppercase tracking-wider text-slate-700 flex items-center gap-2">
                                <i data-lucide="layers" class="w-4 h-4 text-navy-800"></i>
                                Tình Trạng Các Bản Sao (Cuốn Sách Vật Lý Trong Kho)
                            </h4>
                            <span class="text-xs font-bold text-slate-800">
                                Tổng: <strong>@Model.Book.TotalCopies cuốn</strong> • Khả dụng: <strong class="text-emerald-600">@Model.Book.AvailableCopies cuốn [Còn]</strong>
                            </span>
                        </div>

                        <!-- Danh sách các số kiểm soát của tựa sách này lấy trực tiếp từ database -->
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
                            @if (Model.Copies != null && Model.Copies.Any())
                            {
                                foreach (var copy in Model.Copies)
                                {
                                    string borderClass = copy.Status switch
                                    {
                                        "Còn" => "border-emerald-300 bg-white",
                                        "Cho mượn" => "border-amber-300 bg-amber-50/50",
                                        "Hỏng" => "border-rose-300 bg-rose-50/50",
                                        "Mất" => "border-slate-300 bg-slate-100",
                                        _ => "border-slate-200 bg-white"
                                    };

                                    string badgeClass = copy.Status switch
                                    {
                                        "Còn" => "bg-emerald-100 text-emerald-800",
                                        "Cho mượn" => "bg-amber-100 text-amber-800",
                                        "Hỏng" => "bg-rose-100 text-rose-800",
                                        "Mất" => "bg-slate-200 text-slate-700",
                                        _ => "bg-slate-100 text-slate-800"
                                    };

                                    <div class="p-2.5 border rounded-xl flex items-center justify-between @borderClass" title="Ghi chú: @copy.Notes">
                                        <span class="font-mono font-bold text-slate-800">Số KS: @copy.ControlNumber</span>
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold @badgeClass">@copy.Status</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-xs text-slate-400 italic col-span-4">Chưa có bản sao vật lý nào được nhập kho cho tựa sách này.</p>
                            }
                        </div>
                    </div>

                    <!-- THÔNG BÁO RÀNG BUỘC THẺ CỦA ĐỘC GIẢ -->
                    @if (!isAuthenticated)
                    {
                        <div class="p-4 rounded-2xl border border-blue-200 bg-blue-50/80 text-blue-900 text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                            <div class="flex items-center gap-2">
                                <i data-lucide="info" class="w-4 h-4 text-blue-600 flex-shrink-0"></i>
                                <span>Vui lòng <strong>Đăng nhập tài khoản sinh viên</strong> để tra cứu tình trạng Thẻ thư viện và thực hiện đặt mượn sách.</span>
                            </div>
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path"
                               class="px-4 py-2 bg-navy-800 hover:bg-navy-900 text-white rounded-xl font-bold whitespace-nowrap text-center transition-colors">
                                Đăng Nhập Ngay
                            </a>
                        </div>
                    }
                    else
                    {
                        <!-- THẺ THÔNG TIN TÌNH TRẠNG THẺ & HỘP THÔNG BÁO NGHIỆP VỤ HIỆN ĐẠI -->
                        <div class="rounded-2xl border p-4 space-y-3 transition-all text-xs
                            @(userCardStatus != "Sử dụng được" ? "bg-rose-50/90 border-rose-200" :
                              hasOverdueBooks ? "bg-amber-50 border-amber-200" :
                              alreadyHoldingThisBook ? "bg-sky-50 border-sky-200" :
                              hasUnreturnedBooks ? "bg-amber-50 border-amber-200" :
                              "bg-emerald-50/80 border-emerald-200")">
                            
                            <div class="flex items-center justify-between pb-2 border-b @(userCardStatus != "Sử dụng được" ? "border-rose-200/60" : "border-slate-200/60")">
                                <div class="flex items-center gap-2 font-bold text-sm">
                                    @if (userCardStatus != "Sử dụng được")
                                    {
                                        <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse"></span>
                                        <span class="text-rose-900">Thẻ thư viện: <strong>@userCardStatus</strong> (Bị khóa)</span>
                                    }
                                    else
                                    {
                                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                                        <span class="text-emerald-900">Thẻ thư viện: <strong>Hoạt động bình thường</strong></span>
                                    }
                                </div>
                                <span class="px-2.5 py-1 rounded-full text-xs font-bold @(currentBorrowedCount >= 3 ? "bg-amber-200 text-amber-900" : "bg-white/80 text-navy-900 shadow-sm border border-slate-200")">
                                    Đang mượn: <strong>@currentBorrowedCount / 3 cuốn</strong>
                                </span>
                            </div>

                            <!-- BOX THÔNG BÁO CHI TIẾT THEO TÌNH HUỐNG -->
                            @if (userCardStatus != "Sử dụng được")
                            {
                                <div class="flex items-start gap-2.5 text-rose-800">
                                    <i data-lucide="shield-alert" class="w-4 h-4 text-rose-600 mt-0.5 shrink-0"></i>
                                    <div>
                                        <p class="font-bold">Thẻ thư viện hiện đang bị tạm khóa</p>
                                        <p class="text-[11px] text-rose-700 mt-0.5">Tài khoản của bạn đang có sách hỏng, mất chưa thanh toán bồi thường hoặc thẻ đã hết hạn. Vui lòng đến <strong>Quầy thủ thư</strong> để kiểm tra và xử lý mở lại thẻ.</p>
                                    </div>
                                </div>
                            }
                            else if (hasOverdueBooks)
                            {
                                <div class="flex items-start gap-2.5 text-amber-900">
                                    <i data-lucide="clock-alert" class="w-4 h-4 text-amber-600 mt-0.5 shrink-0"></i>
                                    <div>
                                        <p class="font-bold">Đang có sách mượn quá hạn</p>
                                        <p class="text-[11px] text-amber-800 mt-0.5">Bạn có cuốn sách đã quá hạn trả. Vui lòng mang sách đến hoàn trả tại quầy trước khi đăng ký mượn thêm tài liệu mới.</p>
                                    </div>
                                </div>
                            }
                            else if (alreadyHoldingThisBook)
                            {
                                <div class="flex items-start gap-2.5 text-sky-900">
                                    <i data-lucide="info" class="w-4 h-4 text-sky-600 mt-0.5 shrink-0"></i>
                                    <div>
                                        <p class="font-bold">Bạn đang mượn hoặc đã đăng ký tựa sách này</p>
                                        <p class="text-[11px] text-sky-800 mt-0.5">Mỗi độc giả chỉ được mượn 01 cuốn của cùng một tựa sách tại một thời điểm. Bạn vẫn có thể mượn tối đa <strong>@maxAllowedBorrow cuốn sách khác nhau</strong>.</p>
                                    </div>
                                </div>
                            }
                            else if (hasUnreturnedBooks)
                            {
                                <div class="flex items-start gap-2.5 text-amber-900">
                                    <i data-lucide="alert-circle" class="w-4 h-4 text-amber-600 mt-0.5 shrink-0"></i>
                                    <div>
                                        <p class="font-bold">Đã đạt giới hạn mượn (3/3 cuốn)</p>
                                        <p class="text-[11px] text-amber-800 mt-0.5">Bạn đang giữ tối đa 3 cuốn sách được phép mượn cùng lúc. Hãy hoàn trả ít nhất 1 cuốn tại quầy tiếp nhận để tiếp tục mượn các tựa sách mới.</p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-start gap-2.5 text-emerald-800">
                                    <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600 mt-0.5 shrink-0"></i>
                                    <div>
                                        <p class="font-bold">Thẻ đủ điều kiện mượn sách</p>
                                        <p class="text-[11px] text-emerald-700 mt-0.5">Bạn được phép mượn thêm tối đa <strong>@maxAllowedBorrow cuốn sách khác nhau</strong>. Hạn trả sách tiêu chuẩn: <strong>15 ngày</strong> kể từ ngày mượn.</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- CÁC NÚT THAO TÁC CTA -->
                <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center gap-4">
                    @if (canBorrow)
                    {
                        <button onclick="openBorrowModal()" 
                                class="px-8 py-3.5 bg-navy-800 hover:bg-navy-900 text-white rounded-2xl font-bold text-sm shadow-lg shadow-navy-900/20 hover:scale-[1.01] active:scale-[0.99] transition-all flex items-center gap-2">
                            <i data-lucide="bookmark-check" class="w-5 h-5 text-amber-400"></i>
                            Thêm Vào Phiếu Mượn (Hạn 15 ngày)
                        </button>
                    }
                    else if (!isAuthenticated)
                    {
                        <button onclick="handleUnauthenticatedBorrow()" 
                                class="px-8 py-3.5 bg-navy-800 hover:bg-navy-900 text-white rounded-2xl font-bold text-sm shadow-md transition-all flex items-center gap-2">
                            <i data-lucide="log-in" class="w-5 h-5 text-amber-400"></i>
                            Đăng Nhập Để Mượn Sách
                        </button>
                    }
                    else
                    {
                        <button disabled 
                                class="px-8 py-3.5 bg-slate-200 text-slate-400 rounded-2xl font-bold text-sm cursor-not-allowed flex items-center gap-2"
                                title="@(!Model.Book.IsAvailable ? "Hiện tại tất cả bản sao của tựa sách này đều đang được cho mượn" : alreadyHoldingThisBook ? "Bạn đang giữ tựa sách này" : "Tài khoản của bạn tạm thời chưa thể mượn thêm")">
                            <i data-lucide="lock" class="w-4 h-4"></i>
                            @(!Model.Book.IsAvailable ? "Đã Hết Sách Trong Kho" : alreadyHoldingThisBook ? "Đang Mượn Tựa Sách Này" : "Chưa Thể Mượn Thêm")
                        </button>
                    }

                    <a asp-controller="Book" asp-action="Index" 
                       class="px-5 py-3.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-2xl font-semibold text-xs transition-colors flex items-center gap-1.5">
                        <i data-lucide="arrow-left" class="w-4 h-4"></i> Quay lại danh mục
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_Reviews" model="Model" />

<!-- ================= MODAL XÁC NHẬN ĐẶT MƯỢN TRỰC TUYẾN ================= -->
<div id="borrowModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-navy-950/60 backdrop-blur-sm">
    <div class="bg-white rounded-3xl shadow-2xl border border-slate-200 max-w-lg w-full overflow-hidden animate-in fade-in zoom-in-95 duration-150">
        
        <div class="bg-navy-900 text-white p-5 flex items-center justify-between">
            <h3 class="font-bold text-base flex items-center gap-2">
                <i data-lucide="book-up" class="w-5 h-5 text-amber-400"></i> Xác Nhận Lập Phiếu Mượn Sách
            </h3>
            <button onclick="closeBorrowModal()" class="text-slate-400 hover:text-white p-1">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <form id="borrowForm" asp-controller="Borrow" asp-action="CreateRequest" method="post" onsubmit="handleBorrowSubmit(event)" class="p-6 space-y-4 text-xs">
            @Html.AntiForgeryToken()
            <input type="hidden" name="BookId" value="@Model.Book.Id" />
            <input type="hidden" name="BookTitle" value="@Model.Book.Title" />

            <div class="p-3.5 bg-slate-50 border border-slate-200 rounded-2xl space-y-1">
                <p class="font-bold text-slate-900 text-sm">@Model.Book.Title</p>
                <p class="text-slate-500">Mã sách: @Model.Book.ISBN • Kệ: @Model.Book.ShelfLocation</p>
                @if (nextCopy != null)
                {
                    <p class="text-emerald-700 font-bold flex items-center gap-1">
                        <i data-lucide="check" class="w-3.5 h-3.5"></i> Cuốn sách khả dụng tiếp theo sẽ gán: Số kiểm soát [@nextCopy.ControlNumber]
                    </p>
                }
                else
                {
                    <p class="text-rose-600 font-bold">Không còn bản sao khả dụng nào trong kho.</p>
                }
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-bold text-slate-700 uppercase mb-1">Ngày mượn sách</label>
                    <input type="text" readonly value="@DateTime.Today.ToString("dd/MM/yyyy")" 
                           class="w-full p-2.5 bg-slate-100 border border-slate-200 rounded-xl text-slate-700 font-semibold" />
                </div>
                <div>
                    <label class="block font-bold text-slate-700 uppercase mb-1">Hạn trả (dd/mm/yyyy) <span class="text-rose-500">*</span></label>
                    <div class="relative">
                        <input type="text" id="displayDueDate" readonly 
                               value="@DateTime.Today.AddDays(15).ToString("dd/MM/yyyy")"
                               onclick="openDatePicker()"
                               class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:border-navy-800 focus:outline-none font-bold text-navy-800 cursor-pointer pr-10" />
                        <button type="button" onclick="openDatePicker()" class="absolute right-2.5 top-2.5 text-slate-400 hover:text-navy-800">
                            <i data-lucide="calendar" class="w-4 h-4"></i>
                        </button>
                        <input type="date" id="actualDueDate" name="DueDate" required 
                               value="@DateTime.Today.AddDays(15).ToString("yyyy-MM-dd")"
                               min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                               max="@DateTime.Today.AddDays(15).ToString("yyyy-MM-dd")"
                               class="sr-only" 
                               onchange="onDateChanged(this.value)" />
                    </div>
                    <span class="text-[10px] text-slate-400 mt-0.5 block">Nhấp để chọn ngày (tối đa 15 ngày)</span>
                </div>
            </div>

            <!-- Cam kết bồi thường theo đúng Case Study -->
            <div class="p-3 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-[11px] leading-relaxed">
                <strong>Cam kết quy chế:</strong> Độc giả mượn tối đa 3 cuốn sách khác nhau. Nếu làm <strong>Mất</strong> hoặc <strong>Hỏng</strong> sách, Thẻ thư viện sẽ lập tức bị chuyển sang trạng thái <em>"Không sử dụng"</em> và chỉ được mở lại sau khi hoàn tất bồi thường tại quầy.
            </div>

            <label class="flex items-start gap-2 text-slate-600 cursor-pointer pt-1">
                <input type="checkbox" required name="AcceptTerms" value="true" class="w-4 h-4 text-navy-800 rounded border-slate-300 mt-0.5" />
                <span>Tôi đồng ý với thời hạn 15 ngày và cam đoan tuân thủ quy chế bồi thường khi làm mất/hỏng.</span>
            </label>

            <div class="pt-3 border-t border-slate-100 flex justify-end gap-2">
                <button type="button" onclick="closeBorrowModal()" class="px-4 py-2 font-semibold text-slate-600 hover:bg-slate-100 rounded-xl">Hủy</button>
                <button type="submit" id="btnSubmitBorrow" class="px-6 py-2 bg-navy-800 hover:bg-navy-900 text-white rounded-xl font-bold shadow flex items-center gap-2">
                    <span>Xác Nhận Đặt Mượn</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL CẢNH BÁO YÊU CẦU ĐĂNG NHẬP -->
<div id="loginRequiredModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-navy-950/60 backdrop-blur-sm">
    <div class="bg-white rounded-3xl shadow-2xl border border-slate-200 max-w-md w-full p-6 text-center space-y-4">
        <div class="w-16 h-16 rounded-2xl bg-amber-50 text-amber-600 mx-auto flex items-center justify-center border border-amber-200">
            <i data-lucide="lock" class="w-8 h-8"></i>
        </div>
        <div class="space-y-1">
            <h3 class="text-lg font-black text-slate-900">Yêu Cầu Đăng Nhập</h3>
            <p class="text-xs text-slate-500 leading-relaxed">
                Vui lòng đăng nhập tài khoản sinh viên để hệ thống kiểm tra trạng thái Thẻ thư viện và tiến hành lập phiếu mượn sách.
            </p>
        </div>
        <div class="flex gap-2 justify-center pt-2">
            <button onclick="document.getElementById('loginRequiredModal').classList.add('hidden')" 
                    class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-xl">
                Để sau
            </button>
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path"
               class="px-5 py-2 text-xs font-bold bg-navy-800 hover:bg-navy-900 text-white rounded-xl shadow">
                Đăng Nhập Ngay
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openBorrowModal() { 
            document.getElementById('borrowModal')?.classList.remove('hidden'); 
            lucide.createIcons(); 
        }

        function closeBorrowModal() { 
            document.getElementById('borrowModal')?.classList.add('hidden'); 
        }

        function handleUnauthenticatedBorrow() {
            document.getElementById('loginRequiredModal')?.classList.remove('hidden');
            lucide.createIcons();
        }

        async function handleBorrowSubmit(e) {
            e.preventDefault();
            const form = document.getElementById('borrowForm');
            const btn = document.getElementById('btnSubmitBorrow');
            if (!form) return;

            btn.disabled = true;
            btn.innerHTML = `<span class="animate-spin inline-block mr-1">⌛</span> Đang xử lý...`;

            try {
                const formData = new FormData(form);
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    }
                });

                if (response.ok) {
                    const res = await response.json();
                    if (res.requireLogin) {
                        window.location.href = res.loginUrl || '/Account/Login';
                        return;
                    }

                    if (res.success) {
                        closeBorrowModal();
                        showNotification('success', 'Thành công!', res.message);
                        setTimeout(() => {
                            window.location.href = '/Account/Profile';
                        }, 1200);
                    } else {
                        showNotification('error', 'Không thể mượn sách', res.message);
                        btn.disabled = false;
                        btn.innerHTML = `<span>Xác Nhận Đặt Mượn</span>`;
                    }
                } else {
                    form.submit(); // fallback to standard submit
                }
            } catch (err) {
                form.submit();
            }
        }

        function openDatePicker() {
            const input = document.getElementById('actualDueDate');
            if (!input) return;
            if (input.showPicker) {
                input.showPicker();
            } else {
                input.focus();
            }
        }

        function onDateChanged(val) {
            if (!val) return;
            const parts = val.split('-');
            if (parts.length === 3) {
                const display = document.getElementById('displayDueDate');
                if (display) display.value = parts[2] + '/' + parts[1] + '/' + parts[0];
            }
        }
    </script>
}
