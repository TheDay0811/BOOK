@model BOOK.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập Tài Khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-[calc(100vh-14rem)] flex items-center justify-center py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl w-full bg-white rounded-3xl border border-slate-200 shadow-xl overflow-hidden grid grid-cols-1 lg:grid-cols-12">

        <!-- CỘT TRÁI: BANNER THƯ VIỆN HỌC THUẬT (DESKTOP) -->
        <div class="lg:col-span-5 bg-gradient-to-br from-navy-950 via-navy-900 to-navy-800 text-white p-8 sm:p-10 flex flex-col justify-between relative overflow-hidden">
            <!-- Background Decoration Circles -->
            <div class="absolute -bottom-20 -left-20 w-64 h-64 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -top-20 -right-20 w-64 h-64 bg-amber-400/10 rounded-full blur-3xl pointer-events-none"></div>

            <!-- Top Brand -->
            <div class="relative z-10 space-y-4">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-navy-800 to-blue-600 text-white flex items-center justify-center shadow-lg border border-white/10">
                        <i data-lucide="book-open-check" class="w-6 h-6 text-amber-400"></i>
                    </div>
                    <div>
                        <span class="block text-xs uppercase tracking-wider font-semibold text-blue-300">Thư Viện Trung Tâm</span>
                        <h2 class="text-xl font-black tracking-tight text-white">SMART<span class="text-blue-400">LIB</span></h2>
                    </div>
                </div>

                <div class="pt-6">
                    <h3 class="text-2xl sm:text-3xl font-extrabold leading-tight">
                        Cánh Cửa Bước Vào Kho Tàng <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-300 to-amber-300">Tri Thức Số</span>.
                    </h3>
                    <p class="text-xs sm:text-sm text-slate-300 mt-2.5 leading-relaxed">
                        Hệ thống định danh độc giả thông minh giúp bạn tra cứu, đặt mượn giáo trình và quản lý hạn trả tiện lợi mọi lúc mọi nơi.
                    </p>
                </div>
            </div>

            <!-- Highlights List -->
            <div class="relative z-10 py-8 space-y-3.5 border-y border-white/10 my-6">
                <div class="flex items-center gap-3 text-xs text-slate-200">
                    <div class="w-6 h-6 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center flex-shrink-0">
                        <i data-lucide="check" class="w-3.5 h-3.5"></i>
                    </div>
                    <span>Tra cứu hơn 50.000 đầu sách in & học liệu số</span>
                </div>
                <div class="flex items-center gap-3 text-xs text-slate-200">
                    <div class="w-6 h-6 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center flex-shrink-0">
                        <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                    </div>
                    <span>Đặt mượn giữ sách online không mất thời gian chờ</span>
                </div>
                <div class="flex items-center gap-3 text-xs text-slate-200">
                    <div class="w-6 h-6 rounded-lg bg-blue-500/20 text-blue-400 flex items-center justify-center flex-shrink-0">
                        <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
                    </div>
                    <span>Thanh toán phí phạt & gia hạn tự động 24/7</span>
                </div>
            </div>

            <!-- Footer Quote -->
            <div class="relative z-10 text-[11px] text-slate-400 italic">
                “Tri thức là chìa khóa mở ra tiềm năng vô tận của con người.”
            </div>
        </div>

        <!-- CỘT PHẢI: FORM ĐĂNG NHẬP -->
        <div class="lg:col-span-7 p-8 sm:p-12 flex flex-col justify-center bg-white">
            <div class="max-w-md w-full mx-auto space-y-6">

                <!-- Header Form -->
                <div>
                    <span class="text-xs font-bold uppercase tracking-wider text-blue-600">Chào mừng bạn quay lại</span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-1">Đăng Nhập Hệ Thống</h2>
                    <p class="text-xs text-slate-500 mt-1">Sử dụng tài khoản thư viện hoặc mã số sinh viên (MSSV) được cấp.</p>
                </div>

                <!-- Validation Summary (ModelOnly) -->
                <div asp-validation-summary="ModelOnly" class="p-3.5 text-xs text-rose-800 bg-rose-50 border border-rose-200 rounded-xl"></div>

                <!-- Form Login -->
                <form asp-controller="Account" asp-action="Login" method="post" id="loginForm" class="space-y-4">
                    <input type="hidden" asp-for="ReturnUrl" />

                    <!-- Username or Email -->
                    <div>
                        <label asp-for="UsernameOrEmail" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                            Tên đăng nhập hoặc Email <span class="text-rose-500">*</span>
                        </label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <i data-lucide="user" class="w-4 h-4"></i>
                            </div>
                            <input asp-for="UsernameOrEmail" 
                                   placeholder="Nhập tên tài khoản, email hoặc MSSV..." 
                                   class="w-full pl-10 pr-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-navy-800 focus:ring-2 focus:ring-navy-800/20 focus:outline-none transition-all placeholder:text-slate-400" />
                        </div>
                        <span asp-validation-for="UsernameOrEmail" class="text-[11px] text-rose-600 mt-1 block"></span>
                    </div>

                    <!-- Password with Show/Hide Toggle -->
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label asp-for="Password" class="text-xs font-bold uppercase tracking-wider text-slate-700">
                                Mật khẩu <span class="text-rose-500">*</span>
                            </label>
                            <a href="#forgot" onclick="alert('Vui lòng liên hệ quầy Thủ thư hoặc gửi email về thuvien@university.edu.vn để đặt lại mật khẩu.')" 
                               class="text-xs font-medium text-blue-600 hover:text-navy-800 hover:underline">
                                Quên mật khẩu?
                            </a>
                        </div>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <i data-lucide="lock" class="w-4 h-4"></i>
                            </div>
                            <input asp-for="Password" id="passwordInput" type="password" 
                                   placeholder="Nhập mật khẩu của bạn..." 
                                   class="w-full pl-10 pr-10 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-navy-800 focus:ring-2 focus:ring-navy-800/20 focus:outline-none transition-all placeholder:text-slate-400" />
                            <button type="button" onclick="togglePasswordVisibility('passwordInput', 'eyeIcon')" 
                                    class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 transition-colors">
                                <i id="eyeIcon" data-lucide="eye" class="w-4 h-4"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-[11px] text-rose-600 mt-1 block"></span>
                    </div>

                    <!-- Remember Me Checkbox -->
                    <div class="flex items-center justify-between pt-1">
                        <label class="flex items-center gap-2 cursor-pointer select-none text-xs text-slate-600">
                            <input asp-for="RememberMe" class="w-4 h-4 text-navy-800 rounded border-slate-300 focus:ring-navy-800" />
                            <span>Ghi nhớ đăng nhập trên thiết bị này</span>
                        </label>
                    </div>

                    <!-- Submit Button -->
                    <div class="pt-2">
                        <button type="submit" id="submitBtn" 
                                class="w-full py-3 px-4 bg-navy-800 hover:bg-navy-900 text-white rounded-xl text-sm font-bold shadow-md hover:shadow-lg hover:scale-[1.01] active:scale-[0.99] transition-all flex items-center justify-center gap-2">
                            <i data-lucide="log-in" class="w-4 h-4"></i>
                            <span id="btnText">Đăng Nhập</span>
                            <span id="btnLoading" class="hidden items-center gap-2">
                                <span class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
                                Đang xử lý...
                            </span>
                        </button>
                    </div>

                    <!-- Test Credential Quick Links -->
                    <div class="p-3 bg-slate-50 rounded-xl border border-slate-100 text-[11px] text-slate-500 space-y-1">
                        <p class="font-semibold text-slate-700">Tài khoản demo nghiệp vụ:</p>
                        <div class="flex flex-wrap gap-2 text-xs">
                            <button type="button" onclick="fillDemo('sv001', '123456')" class="px-2 py-0.5 bg-white border border-slate-200 rounded text-slate-700 hover:border-navy-800">
                                🧑 Độc giả
                            </button>
                            <button type="button" onclick="fillDemo('thuthu', 'thuthu123')" class="px-2 py-0.5 bg-blue-50 border border-blue-200 rounded text-navy-800 hover:border-navy-800">
                                🛡️ Thủ thư
                            </button>
                            <button type="button" onclick="fillDemo('admin', 'admin123')" class="px-2 py-0.5 bg-amber-50 border border-amber-200 rounded text-amber-800 hover:border-navy-800">
                                👑 Quản trị viên
                            </button>
                        </div>
                    </div>
                </form>

                <!-- Link sang Đăng ký -->
                <div class="pt-4 border-t border-slate-100 text-center text-xs text-slate-500">
                    Chưa có tài khoản độc giả? 
                    <a asp-controller="Account" asp-action="Register" class="font-bold text-navy-800 hover:text-blue-600 hover:underline">
                        Đăng ký làm thẻ ngay
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePasswordVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;

            if (input.type === 'password') {
                input.type = 'text';
                icon.setAttribute('data-lucide', 'eye-off');
            } else {
                input.type = 'password';
                icon.setAttribute('data-lucide', 'eye');
            }
            lucide.createIcons();
        }

        function fillDemo(username, pwd) {
            document.querySelector('[name="UsernameOrEmail"]').value = username;
            document.getElementById('passwordInput').value = pwd;
        }

        // Handle button submit spinner
        const form = document.getElementById('loginForm');
        if (form) {
            form.addEventListener('submit', () => {
                if (form.checkValidity()) {
                    document.getElementById('btnText').classList.add('hidden');
                    document.getElementById('btnLoading').classList.remove('hidden');
                    document.getElementById('btnLoading').classList.add('inline-flex');
                }
            });
        }
    </script>
}
