@model BOOK.Models.ViewModels.BorrowAnalyticsReportViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Báo Cáo Thống Kê & Top Sách Mượn";
}

<div class="space-y-6">

    <!-- BREADCRUMB & HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <nav class="flex items-center gap-2 text-xs text-slate-500 mb-1">
                <span>Báo cáo & Thống kê</span>
                <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-slate-400"></i>
                <span class="text-navy-800 font-bold">Thống kê lưu thông & Top sách</span>
            </nav>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">Thống Kê Hoạt Động Mượn Trả & Top Sách</h1>
            <p class="text-xs text-slate-500 mt-0.5">Phân tích tần suất mượn sách, tỷ lệ quay vòng tài liệu và cảnh báo quá hạn trong toàn hệ thống thư viện.</p>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
            <a asp-area="Admin" asp-controller="Report" asp-action="DamagedLostBooks"
               class="px-4 py-2.5 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-xl text-xs font-bold shadow-sm transition-all flex items-center gap-2">
                <i data-lucide="alert-octagon" class="w-4 h-4 text-rose-600"></i> Báo Cáo Sách Mất/Hỏng
            </a>
            <button onclick="window.print();" 
                    class="px-4 py-2.5 bg-navy-800 hover:bg-navy-900 text-white rounded-xl text-xs font-bold shadow transition-all flex items-center gap-2">
                <i data-lucide="printer" class="w-4 h-4 text-amber-400"></i> In Báo Cáo
            </button>
        </div>
    </div>

    <!-- 4 THẺ CHỈ SỐ KPI CHÍNH -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Tổng Lượt Mượn</span>
                <h3 class="text-2xl font-black text-navy-900 mt-0.5">@Model.TotalBorrows.ToString("N0")</h3>
                <span class="text-[11px] text-emerald-600 font-semibold flex items-center gap-1 mt-0.5">
                    <i data-lucide="activity" class="w-3 h-3"></i> Tích lũy toàn thời gian
                </span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                <i data-lucide="book-open" class="w-6 h-6"></i>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Đang Mượn Lưu Thông</span>
                <h3 class="text-2xl font-black text-blue-600 mt-0.5">@Model.ActiveBorrows.ToString("N0")</h3>
                <span class="text-[11px] text-slate-500">Độc giả đang giữ sách</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
                <i data-lucide="bookmark-check" class="w-6 h-6"></i>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Đang Quá Hạn (>15 ngày)</span>
                <h3 class="text-2xl font-black text-rose-600 mt-0.5">@Model.OverdueBorrows.ToString("N0")</h3>
                <span class="text-[11px] text-rose-600 font-semibold flex items-center gap-1 mt-0.5">
                    <i data-lucide="alert-circle" class="w-3 h-3"></i> Cần gửi thông báo nhắc
                </span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center">
                <i data-lucide="clock" class="w-6 h-6"></i>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Tiền Bồi Thường Đã Thu</span>
                <h3 class="text-2xl font-black text-emerald-600 mt-0.5">@Model.TotalCompensations.ToString("N0") đ</h3>
                <span class="text-[11px] text-slate-500">Từ sách hỏng / mất</span>
            </div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <i data-lucide="coins" class="w-6 h-6"></i>
            </div>
        </div>
    </div>

    <!-- TOP 5 SÁCH MƯỢN NHIỀU NHẤT -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-50/50">
            <div>
                <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-xs">
                        <i data-lucide="flame" class="w-4 h-4"></i>
                    </div>
                    <h2 class="text-base font-bold text-slate-900">Bảng Xếp Hạng Top 5 Sách Mượn Nhiều Nhất</h2>
                </div>
                <p class="text-xs text-slate-500 mt-1">Dựa trên dữ liệu tổng hợp từ các phiếu mượn thực tế trong cơ sở dữ liệu thư viện.</p>
            </div>
            <a asp-area="Admin" asp-controller="Book" asp-action="Index"
               class="text-xs font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1">
                Xem toàn bộ kho sách <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
            </a>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-slate-50/75 border-b border-slate-200 text-slate-500 uppercase tracking-wider font-bold">
                        <th class="py-3.5 px-4 text-center w-16">Thứ Hạng</th>
                        <th class="py-3.5 px-4">Thông Tin Sách</th>
                        <th class="py-3.5 px-4">Thể Loại</th>
                        <th class="py-3.5 px-4 text-center">Số Bản Sách Vật Lý</th>
                        <th class="py-3.5 px-4 text-center">Số Lượt Mượn</th>
                        <th class="py-3.5 px-4">Tần Suất & Mức Độ Quan Tâm</th>
                        <th class="py-3.5 px-4 text-right">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
                    @if (Model.TopBooks != null && Model.TopBooks.Any())
                    {
                        var rank = 1;
                        var maxBorrows = Model.TopBooks.Max(b => b.BorrowCount);
                        if (maxBorrows == 0) maxBorrows = 1;

                        foreach (var book in Model.TopBooks)
                        {
                            var percentage = Math.Min(100, (int)Math.Round((double)book.BorrowCount / maxBorrows * 100));
                            var rankBadgeClass = rank switch
                            {
                                1 => "bg-amber-500 text-white shadow-sm ring-2 ring-amber-300",
                                2 => "bg-slate-400 text-white shadow-sm ring-2 ring-slate-300",
                                3 => "bg-amber-700 text-white shadow-sm ring-2 ring-amber-600",
                                _ => "bg-slate-100 text-slate-600"
                            };

                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="py-4 px-4 text-center">
                                    <span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-black @rankBadgeClass">
                                        @rank
                                    </span>
                                </td>
                                <td class="py-4 px-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-12 bg-slate-100 rounded border border-slate-200 flex items-center justify-center shrink-0 text-slate-400">
                                            <i data-lucide="book" class="w-5 h-5"></i>
                                        </div>
                                        <div>
                                            <a asp-area="Admin" asp-controller="Book" asp-action="Details" asp-route-id="@book.BookId"
                                               class="font-bold text-navy-900 hover:text-blue-600 text-sm line-clamp-1 transition-colors">
                                                @book.Title
                                            </a>
                                            <span class="inline-block mt-0.5 text-[11px] font-mono text-slate-400">Mã: @book.BookCode</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-4">
                                    <span class="inline-block px-2.5 py-1 rounded-full text-[11px] font-semibold bg-blue-50 text-blue-700 border border-blue-100">
                                        @book.CategoryName
                                    </span>
                                </td>
                                <td class="py-4 px-4 text-center font-bold text-slate-800">
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 bg-slate-100 rounded-md">
                                        <i data-lucide="layers" class="w-3 h-3 text-slate-400"></i> @book.TotalCopies bản
                                    </span>
                                </td>
                                <td class="py-4 px-4 text-center">
                                    <span class="text-base font-black text-navy-800">@book.BorrowCount</span>
                                    <span class="text-[10px] text-slate-400 block">lượt</span>
                                </td>
                                <td class="py-4 px-4 w-48">
                                    <div class="space-y-1">
                                        <div class="flex justify-between text-[10px] font-semibold text-slate-500">
                                            <span>Mức độ quan tâm</span>
                                            <span class="text-navy-800 font-bold">@percentage%</span>
                                        </div>
                                        <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                                            <div class="bg-gradient-to-r from-blue-600 to-indigo-600 h-2 rounded-full transition-all duration-500" style="width: @percentage%"></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-4 text-right">
                                    <a asp-area="Admin" asp-controller="Book" asp-action="Details" asp-route-id="@book.BookId"
                                       class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-100 hover:bg-navy-800 hover:text-white text-slate-700 rounded-lg text-xs font-bold transition-all">
                                        <i data-lucide="eye" class="w-3.5 h-3.5"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                            rank++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-slate-400">
                                <i data-lucide="inbox" class="w-10 h-10 mx-auto mb-2 text-slate-300"></i>
                                <p class="text-sm font-semibold">Chưa có dữ liệu lượt mượn nào được ghi nhận.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- QUY ĐỊNH LƯU THÔNG VÀ GHI CHÚ ĐIỀU HÀNH -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-3">
            <div class="flex items-center gap-2 text-navy-900 font-bold text-sm">
                <i data-lucide="shield-alert" class="w-4 h-4 text-amber-500"></i>
                Quy Định Ràng Buộc Lưu Thông Tự Động
            </div>
            <ul class="text-xs text-slate-600 space-y-2 list-disc list-inside">
                <li><strong class="text-slate-800">Số sách tối đa:</strong> Mỗi độc giả chỉ được mượn cùng lúc tối đa <span class="text-blue-600 font-bold">3 cuốn</span>.</li>
                <li><strong class="text-slate-800">Thời hạn mượn:</strong> Không quá <span class="text-blue-600 font-bold">15 ngày</span> kể từ ngày lập phiếu mượn.</li>
                <li><strong class="text-slate-800">Chặn mượn tiếp:</strong> Độc giả đang giữ sách chưa hoàn trả hoặc thẻ bị khóa ("Không sử dụng") sẽ bị hệ thống tự động từ chối đặt mượn.</li>
                <li><strong class="text-slate-800">Sách hỏng / mất:</strong> Tự động khóa thẻ thư viện; chỉ mở khóa khi hoàn tất ghi nhận bồi thường.</li>
            </ul>
        </div>

        <div class="bg-gradient-to-br from-navy-900 to-slate-900 text-white p-5 rounded-2xl shadow-sm space-y-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-amber-400 flex items-center gap-1.5 uppercase tracking-wider">
                    <i data-lucide="sliders" class="w-4 h-4"></i> Cấu Hình Thông Số
                </span>
                <a asp-area="Admin" asp-controller="Report" asp-action="Settings" 
                   class="px-2.5 py-1 bg-white/10 hover:bg-white/20 text-white text-[11px] rounded-lg font-bold transition-colors">
                    Điều chỉnh
                </a>
            </div>
            <h4 class="text-base font-bold">Thông Số Vận Hành Hiện Tại</h4>
            <div class="grid grid-cols-2 gap-3 text-xs">
                <div class="bg-white/5 p-2.5 rounded-xl border border-white/10">
                    <span class="text-slate-400 text-[10px] block">Hạn mượn tối đa</span>
                    <span class="text-lg font-black text-amber-400">15</span> ngày
                </div>
                <div class="bg-white/5 p-2.5 rounded-xl border border-white/10">
                    <span class="text-slate-400 text-[10px] block">Sách mượn tối đa</span>
                    <span class="text-lg font-black text-emerald-400">3</span> cuốn
                </div>
                <div class="bg-white/5 p-2.5 rounded-xl border border-white/10">
                    <span class="text-slate-400 text-[10px] block">Phí phạt trễ hạn</span>
                    <span class="text-lg font-black text-blue-300">2.000</span> đ/ngày
                </div>
                <div class="bg-white/5 p-2.5 rounded-xl border border-white/10">
                    <span class="text-slate-400 text-[10px] block">Thời hạn thẻ SV</span>
                    <span class="text-lg font-black text-purple-300">1</span> năm
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.lucide) {
                lucide.createIcons();
            }
        });
    </script>
}
