@model BOOK.Models.ViewModels.UnifiedReportViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Báo Cáo & Phân Tích Dữ Liệu Thư Viện";
    var a = Model.Analytics;
    var d = Model.DamagedLost;
    var isDamagedTab = Model.ActiveTab == "damaged";
}

<div class="space-y-6">

    <!-- BREADCRUMB & HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <nav class="flex items-center gap-2 text-xs text-slate-500 mb-1">
                <span>Quản trị hệ thống</span>
                <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-slate-400"></i>
                <span class="text-navy-800 font-bold">Báo cáo & Phân tích</span>
            </nav>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2.5">
                <i data-lucide="bar-chart-3" class="w-7 h-7 text-blue-600"></i>
                Báo Cáo Thống Kê & Phân Tích Dữ Liệu
            </h1>
            <p class="text-xs text-slate-500 mt-0.5">Dữ liệu hợp nhất thời gian thực từ CSDL: Lưu thông tài liệu, Top sách mượn và Thống kê sách hỏng/mất.</p>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
            <button onclick="window.print();" 
                    class="px-4 py-2 bg-navy-800 hover:bg-navy-900 text-white rounded-xl text-xs font-bold shadow transition-all flex items-center gap-1.5 cursor-pointer">
                <i data-lucide="printer" class="w-4 h-4 text-amber-400"></i> In Báo Cáo
            </button>
        </div>
    </div>

    <!-- TABS CHUYỂN ĐỔI BÁO CÁO ĐỒNG BỘ -->
    <div class="flex items-center gap-2 p-1.5 bg-slate-100/80 rounded-2xl w-fit border border-slate-200">
        <a asp-action="Index" asp-route-tab="overview"
           class="px-5 py-2.5 rounded-xl font-bold text-xs transition-all flex items-center gap-2 @(!isDamagedTab ? "bg-white text-navy-900 shadow-sm" : "text-slate-600 hover:text-navy-900")">
            <i data-lucide="line-chart" class="w-4 h-4 @(!isDamagedTab ? "text-blue-600" : "")"></i>
            <span>Lưu Thông & Top Sách</span>
        </a>
        <a asp-action="Index" asp-route-tab="damaged"
           class="px-5 py-2.5 rounded-xl font-bold text-xs transition-all flex items-center gap-2 @(isDamagedTab ? "bg-white text-navy-900 shadow-sm" : "text-slate-600 hover:text-navy-900")">
            <i data-lucide="alert-octagon" class="w-4 h-4 @(isDamagedTab ? "text-rose-600" : "")"></i>
            <span>Sách Hỏng & Thanh Lý</span>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @(d.Records.Count > 0 ? "bg-rose-100 text-rose-800" : "bg-slate-200 text-slate-600")">
                @d.Records.Count
            </span>
        </a>
    </div>

    @if (!isDamagedTab)
    {
        <!-- TAB 1: THỐNG KÊ LƯU THÔNG & TOP SÁCH -->
        <div class="space-y-6 animate-in fade-in duration-150">
            <!-- 4 THẺ CHỈ SỐ KPI CHÍNH -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Tổng Lượt Mượn</span>
                        <h3 class="text-2xl font-black text-navy-900 mt-0.5">@a.TotalBorrows.ToString("N0")</h3>
                        <span class="text-[11px] text-emerald-600 font-semibold flex items-center gap-1 mt-0.5">
                            <i data-lucide="activity" class="w-3 h-3"></i> Tích lũy CSDL thật
                        </span>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center">
                        <i data-lucide="book-open" class="w-6 h-6"></i>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Đang Mượn Lưu Thông</span>
                        <h3 class="text-2xl font-black text-blue-600 mt-0.5">@a.ActiveBorrows.ToString("N0")</h3>
                        <span class="text-[11px] text-slate-500">Phiếu đang phục vụ</span>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
                        <i data-lucide="bookmark-check" class="w-6 h-6"></i>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Quá Hạn (>15 ngày)</span>
                        <h3 class="text-2xl font-black text-rose-600 mt-0.5">@a.OverdueBorrows.ToString("N0")</h3>
                        <span class="text-[11px] text-rose-600 font-semibold flex items-center gap-1 mt-0.5">
                            <i data-lucide="alert-circle" class="w-3 h-3"></i> Cần hoàn trả
                        </span>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center">
                        <i data-lucide="clock" class="w-6 h-6"></i>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Bồi Thường Đã Thu</span>
                        <h3 class="text-2xl font-black text-emerald-600 mt-0.5">@a.TotalCompensations.ToString("N0") đ</h3>
                        <span class="text-[11px] text-slate-500">Đã quyết toán</span>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                        <i data-lucide="coins" class="w-6 h-6"></i>
                    </div>
                </div>
            </div>

            <!-- BẢNG XẾP HẠNG TOP SÁCH MƯỢN NHIỀU NHẤT -->
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="p-6 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-50/50">
                    <div>
                        <div class="flex items-center gap-2">
                            <div class="w-7 h-7 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-xs">
                                <i data-lucide="flame" class="w-4 h-4"></i>
                            </div>
                            <h2 class="text-base font-bold text-slate-900">Bảng Xếp Hạng Top Sách Mượn Nhiều Nhất</h2>
                        </div>
                        <p class="text-xs text-slate-500 mt-1">Tổng hợp theo số lượt được mượn thực tế từ sinh viên.</p>
                    </div>
                    <a asp-area="Admin" asp-controller="Book" asp-action="Index"
                       class="text-xs font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1">
                        Xem toàn bộ kho sách <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                    </a>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs text-slate-600">
                        <thead class="bg-slate-50 text-slate-500 uppercase font-bold border-b border-slate-200 text-[11px]">
                            <tr>
                                <th class="py-3 px-4 w-12 text-center">Hạng</th>
                                <th class="py-3 px-4">Tên Tựa Sách</th>
                                <th class="py-3 px-4">Mã Sách</th>
                                <th class="py-3 px-4">Chuyên Ngành</th>
                                <th class="py-3 px-4 text-center">Tổng Bản Sao</th>
                                <th class="py-3 px-4 text-right">Lượt Mượn</th>
                                <th class="py-3 px-4 text-center">Hành Động</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200">
                            @if (a.TopBooks == null || !a.TopBooks.Any())
                            {
                                <tr>
                                    <td colspan="7" class="py-8 text-center text-slate-400">
                                        Chưa có dữ liệu lượt mượn nào được ghi nhận.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int rank = 1;
                                foreach (var book in a.TopBooks)
                                {
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="py-3.5 px-4 text-center font-bold">
                                            @if (rank == 1)
                                            {
                                                <span class="w-6 h-6 rounded-full bg-amber-400 text-navy-950 font-black inline-flex items-center justify-center text-xs shadow-sm">1</span>
                                            }
                                            else if (rank == 2)
                                            {
                                                <span class="w-6 h-6 rounded-full bg-slate-300 text-slate-800 font-bold inline-flex items-center justify-center text-xs">2</span>
                                            }
                                            else if (rank == 3)
                                            {
                                                <span class="w-6 h-6 rounded-full bg-amber-700 text-white font-bold inline-flex items-center justify-center text-xs">3</span>
                                            }
                                            else
                                            {
                                                <span class="text-slate-400">@rank</span>
                                            }
                                        </td>
                                        <td class="py-3.5 px-4 font-bold text-slate-900 max-w-sm">
                                            <p class="truncate">@book.Title</p>
                                        </td>
                                        <td class="py-3.5 px-4 font-mono font-bold text-blue-900">
                                            @book.BookCode
                                        </td>
                                        <td class="py-3.5 px-4">
                                            <span class="px-2 py-0.5 rounded-lg bg-blue-50 text-blue-800 font-semibold text-[11px]">
                                                @book.CategoryName
                                            </span>
                                        </td>
                                        <td class="py-3.5 px-4 text-center font-semibold text-slate-700">
                                            @book.TotalCopies bản
                                        </td>
                                        <td class="py-3.5 px-4 text-right font-black text-emerald-600 text-sm">
                                            @book.BorrowCount lượt
                                        </td>
                                        <td class="py-3.5 px-4 text-center">
                                            <a asp-controller="Book" asp-action="Details" asp-route-id="@book.BookId" asp-area="" target="_blank"
                                               class="px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg font-bold text-[11px] transition-colors inline-block">
                                                Xem
                                            </a>
                                        </td>
                                    </tr>
                                    rank++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- TAB 2: SÁCH HỎNG, MẤT & ĐỀ XUẤT THANH LÝ -->
        <div class="space-y-6 animate-in fade-in duration-150">
            <!-- 3 THẺ CHỈ SỐ -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Tổng Sách Hỏng</span>
                        <h3 class="text-2xl font-black text-amber-600 mt-0.5">@d.TotalDamagedCount cuốn</h3>
                        <span class="text-[11px] text-slate-500">Định mức phạt: 50.000 VNĐ/cuốn</span>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center">
                        <i data-lucide="alert-triangle" class="w-6 h-6"></i>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Tổng Sách Mất</span>
                        <h3 class="text-2xl font-black text-rose-600 mt-0.5">@d.TotalLostCount cuốn</h3>
                        <span class="text-[11px] text-slate-500">Định mức phạt: 100.000 VNĐ/cuốn</span>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center">
                        <i data-lucide="shield-alert" class="w-6 h-6"></i>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Tiền Bồi Thường Thu Được</span>
                        <h3 class="text-2xl font-black text-emerald-600 mt-0.5">@d.TotalCompensationCollected.ToString("N0") VNĐ</h3>
                        <span class="text-[11px] text-emerald-600 font-semibold">Đã nhập quỹ bồi thường</span>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                        <i data-lucide="coins" class="w-6 h-6"></i>
                    </div>
                </div>
            </div>

            <!-- BẢNG DANH MỤC SÁCH HỎNG/MẤT VÀ THANH LÝ -->
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden space-y-4 p-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-slate-100">
                    <div>
                        <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                            <i data-lucide="clipboard-list" class="w-5 h-5 text-rose-500"></i>
                            Danh Mục Sách Hỏng / Mất Cần Bồi Thường & Thanh Lý
                        </h3>
                        <p class="text-xs text-slate-400">Dữ liệu thực tế được cập nhật tự động khi Thủ thư xác nhận tại Quầy Tiếp Nhận Trả</p>
                    </div>

                    <a asp-area="Admin" asp-controller="Borrow" asp-action="Payment"
                       class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-navy-950 font-bold text-xs rounded-xl shadow transition-colors flex items-center gap-1.5 w-fit">
                        <i data-lucide="credit-card" class="w-4 h-4"></i> Mở Quầy Thu Phạt Tại Chỗ
                    </a>
                </div>

                <div class="overflow-x-auto rounded-2xl border border-slate-200">
                    <table class="w-full text-left text-xs text-slate-600">
                        <thead class="bg-slate-50 text-slate-500 uppercase font-bold border-b border-slate-200 text-[11px]">
                            <tr>
                                <th class="py-3 px-4">Mã Sách</th>
                                <th class="py-3 px-4 text-center">Số KS</th>
                                <th class="py-3 px-4">Tên Tựa Sách</th>
                                <th class="py-3 px-4">Tình Trạng</th>
                                <th class="py-3 px-4">Ngày Ghi Nhận</th>
                                <th class="py-3 px-4">Độc Giả Liên Quan</th>
                                <th class="py-3 px-4">Bồi Thường</th>
                                <th class="py-3 px-4 text-right">Trạng Thái Thanh Lý</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200">
                            @if (d.Records == null || !d.Records.Any())
                            {
                                <tr>
                                    <td colspan="8" class="py-10 text-center text-slate-400">
                                        <i data-lucide="check-circle-2" class="w-8 h-8 mx-auto text-emerald-500 mb-2"></i>
                                        Hiện không có cuốn sách nào bị mất hoặc hư hỏng trong kho thư viện.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in d.Records)
                                {
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="py-3.5 px-4 font-mono font-bold text-navy-800">
                                            @item.BookCode
                                        </td>
                                        <td class="py-3.5 px-4 text-center font-mono font-black text-navy-950">
                                            [@item.ControlNumber]
                                        </td>
                                        <td class="py-3.5 px-4 max-w-xs font-semibold text-slate-900">
                                            <p class="truncate">@item.BookTitle</p>
                                            <span class="text-[10px] text-slate-400">@item.CategoryName</span>
                                        </td>
                                        <td class="py-3.5 px-4">
                                            @if (item.ConditionStatus == "Hỏng")
                                            {
                                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200">
                                                    ⚠️ Hỏng
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 border border-rose-200">
                                                    ⛔ Mất
                                                </span>
                                            }
                                        </td>
                                        <td class="py-3.5 px-4 text-slate-500">
                                            @item.RecordedDate.ToString("dd/MM/yyyy")
                                        </td>
                                        <td class="py-3.5 px-4">
                                            <p class="font-bold text-slate-900">@item.StudentName</p>
                                            <span class="text-[10px] text-slate-400 font-mono">@item.StudentCode</span>
                                        </td>
                                        <td class="py-3.5 px-4">
                                            @if (item.CompensationStatus == "Đã bồi thường")
                                            {
                                                <span class="text-emerald-700 font-bold flex items-center gap-1 text-[11px]">
                                                    <i data-lucide="check" class="w-3.5 h-3.5"></i> Đã thu (@item.CompensationAmount.ToString("N0")đ)
                                                </span>
                                            }
                                            else
                                            {
                                                <a asp-area="Admin" asp-controller="Borrow" asp-action="Payment" asp-route-searchTerm="@item.StudentCode"
                                                   class="text-rose-600 font-bold hover:underline flex items-center gap-1 text-[11px]">
                                                    <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i> Chưa bồi thường (@item.CompensationAmount.ToString("N0")đ)
                                                </a>
                                            }
                                        </td>
                                        <td class="py-3.5 px-4 text-right">
                                            <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-slate-100 text-slate-700">
                                                @item.LiquidationStatus
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

</div>
