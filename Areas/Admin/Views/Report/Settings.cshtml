@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Cấu Hình Quy Định & Thông Số Thư Viện";
}

<div class="space-y-6">

    <!-- BREADCRUMB & HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <nav class="flex items-center gap-2 text-xs text-slate-500 mb-1">
                <span>Hệ thống</span>
                <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-slate-400"></i>
                <span class="text-navy-800 font-bold">Cấu hình tham số</span>
            </nav>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">Cấu Hình Thông Số & Quy Chế Mượn Trả</h1>
            <p class="text-xs text-slate-500 mt-0.5">Thiết lập các ngưỡng kiểm soát lưu thông tự động theo quy định của Thư viện Đại học.</p>
        </div>

        <div class="flex items-center gap-2">
            <a asp-area="Admin" asp-controller="Report" asp-action="Index"
               class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition-all flex items-center gap-2">
                <i data-lucide="arrow-left" class="w-4 h-4"></i> Quay Lại Báo Cáo
            </a>
            <button type="button" onclick="saveSettings()"
                    class="px-4 py-2.5 bg-navy-800 hover:bg-navy-900 text-white rounded-xl text-xs font-bold shadow transition-all flex items-center gap-2">
                <i data-lucide="save" class="w-4 h-4 text-emerald-400"></i> Lưu Cấu Hình
            </button>
        </div>
    </div>

    <!-- MAIN FORM GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- CỘT TRÁI: CÁC THAM SỐ LƯU THÔNG CỐT LÕI -->
        <div class="lg:col-span-2 space-y-6">

            <!-- CARD 1: THỜI HẠN & SỐ LƯỢNG MƯỢN -->
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-5">
                <div class="flex items-center gap-2 pb-3 border-b border-slate-100">
                    <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold">
                        <i data-lucide="calendar" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-900">1. Quy Chế Thời Hạn & Số Lượng</h3>
                        <p class="text-[11px] text-slate-500">Quy định số lượng sách và thời gian mượn tối đa cho mỗi tài khoản sinh viên.</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Số ngày mượn tối đa (ngày) <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <input type="number" id="maxLoanDays" value="15" min="1" max="90"
                                   class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            <span class="absolute right-3 top-2.5 text-slate-400 text-xs">ngày</span>
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1">Theo quy định hiện hành: Đúng 15 ngày kể từ ngày phê duyệt mượn.</p>
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Số sách mượn tối đa / lượt (cuốn) <span class="text-rose-500">*</span></label>
                        <div class="relative">
                            <input type="number" id="maxBookCount" value="3" min="1" max="10"
                                   class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            <span class="absolute right-3 top-2.5 text-slate-400 text-xs">cuốn</span>
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1">Tối đa 3 mã sách cho mỗi lần lập phiếu mượn.</p>
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Thời hạn hiệu lực Thẻ độc giả (ngày)</label>
                        <div class="relative">
                            <input type="number" id="cardDuration" value="365" min="30" max="1825"
                                   class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            <span class="absolute right-3 top-2.5 text-slate-400 text-xs">ngày</span>
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1">Thẻ thư viện có hiệu lực 1 năm tính từ ngày đăng ký thẻ.</p>
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Thời gian gia hạn thêm (ngày)</label>
                        <div class="relative">
                            <input type="number" id="renewDays" value="7" min="1" max="15"
                                   class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            <span class="absolute right-3 top-2.5 text-slate-400 text-xs">ngày</span>
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1">Chỉ áp dụng khi sách chưa có độc giả khác đặt trước.</p>
                    </div>
                </div>
            </div>

            <!-- CARD 2: PHÍ PHẠT & BỒI THƯỜNG -->
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-5">
                <div class="flex items-center gap-2 pb-3 border-b border-slate-100">
                    <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
                        <i data-lucide="coins" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-900">2. Biểu Phí Quá Hạn & Bồi Thường Hư Hỏng</h3>
                        <p class="text-[11px] text-slate-500">Mức tiền phạt tự động tính khi độc giả trả sách quá hạn hoặc làm mất, hỏng tài liệu.</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Mức phạt trễ hạn (VNĐ / ngày / cuốn)</label>
                        <div class="relative">
                            <input type="number" id="overdueFineDaily" value="2000" step="500"
                                   class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            <span class="absolute right-3 top-2.5 text-slate-400 text-xs">đ/ngày</span>
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1">Áp dụng từ ngày thứ 16 sau khi mượn sách.</p>
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Bồi thường khi mất sách (% giá trị sách)</label>
                        <div class="relative">
                            <input type="number" id="lostCompensationPercent" value="200" step="10"
                                   class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            <span class="absolute right-3 top-2.5 text-slate-400 text-xs">%</span>
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1">Đền bù bằng 200% giá trị sách theo quy chế hội đồng.</p>
                    </div>
                </div>
            </div>

            <!-- CARD 3: TỰ ĐỘNG KHÓA THẺ & RÀNG BUỘC NGHIỆP VỤ -->
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                <div class="flex items-center gap-2 pb-3 border-b border-slate-100">
                    <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold">
                        <i data-lucide="shield-check" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-900">3. Cơ Chế Kiểm Soát Tự Động (Strict Enforcement)</h3>
                        <p class="text-[11px] text-slate-500">Các quy tắc logic được hệ thống EF Core thực thi tự động khi độc giả đặt mượn.</p>
                    </div>
                </div>

                <div class="space-y-3 text-xs">
                    <label class="flex items-start gap-3 p-3 rounded-xl bg-slate-50 border border-slate-200 cursor-pointer hover:bg-slate-100 transition-colors">
                        <input type="checkbox" checked disabled class="mt-0.5 rounded text-blue-600 focus:ring-blue-500 w-4 h-4" />
                        <div>
                            <span class="font-bold text-slate-800">Chặn mượn nếu còn sách chưa hoàn trả</span>
                            <p class="text-[11px] text-slate-500 mt-0.5">Sinh viên đang có ít nhất 1 cuốn sách chưa hoàn trả thực tế thì không thể lập thêm phiếu mượn mới.</p>
                        </div>
                    </label>

                    <label class="flex items-start gap-3 p-3 rounded-xl bg-slate-50 border border-slate-200 cursor-pointer hover:bg-slate-100 transition-colors">
                        <input type="checkbox" checked disabled class="mt-0.5 rounded text-blue-600 focus:ring-blue-500 w-4 h-4" />
                        <div>
                            <span class="font-bold text-slate-800">Tự động chuyển thẻ sang "Không sử dụng" khi ghi nhận Hỏng/Mất</span>
                            <p class="text-[11px] text-slate-500 mt-0.5">Ngay khi thủ thư ghi nhận sách bị hỏng hoặc mất, thẻ độc giả bị khóa ngay lập tức và chỉ phục hồi sau khi hoàn tất bồi thường.</p>
                        </div>
                    </label>

                    <label class="flex items-start gap-3 p-3 rounded-xl bg-slate-50 border border-slate-200 cursor-pointer hover:bg-slate-100 transition-colors">
                        <input type="checkbox" checked disabled class="mt-0.5 rounded text-blue-600 focus:ring-blue-500 w-4 h-4" />
                        <div>
                            <span class="font-bold text-slate-800">Kiểm soát theo Số Kiểm Soát của từng bản sách vật lý</span>
                            <p class="text-[11px] text-slate-500 mt-0.5">Mỗi cuốn sách vật lý có số kiểm soát duy nhất (001, 002...), trạng thái cập nhật độc lập.</p>
                        </div>
                    </label>
                </div>
            </div>

        </div>

        <!-- CỘT PHẢI: THÔNG TIN PHÁP LÝ & HƯỚNG DẪN THỦ THƯ -->
        <div class="space-y-6">

            <div class="bg-navy-900 text-white p-6 rounded-2xl shadow-sm space-y-4">
                <div class="w-10 h-10 rounded-xl bg-amber-400 text-navy-900 flex items-center justify-center font-bold">
                    <i data-lucide="scale" class="w-5 h-5"></i>
                </div>
                <h3 class="text-base font-bold text-white">Văn Bản Pháp Lý Áp Dụng</h3>
                <p class="text-xs text-slate-300 leading-relaxed">
                    Hệ thống lưu thông hoạt động theo Quyết định số 142/QĐ-ĐH về việc ban hành Nội quy Thư viện Trường Đại học. Mọi sửa đổi tham số trên đây sẽ có hiệu lực trực tiếp cho các phiếu mượn phát sinh sau thời điểm lưu.
                </p>
                <div class="pt-2 border-t border-white/10 text-[11px] text-slate-400">
                    Phiên bản quy chế: <strong>2026.1 - Ban hành 01/2026</strong>
                </div>
            </div>

            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-3">
                <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider flex items-center gap-1.5">
                    <i data-lucide="help-circle" class="w-4 h-4 text-blue-600"></i> Hướng Dẫn Vận Hành
                </h4>
                <div class="text-xs text-slate-600 space-y-2">
                    <p>• Để thay đổi hạn mượn cho một trường hợp ngoại lệ (giảng viên nghiên cứu, luận văn), thủ thư có thể trực tiếp gia hạn thủ công tại trang Chi Tiết Phiếu Mượn.</p>
                    <p>• Đề xuất thanh lý tài sản sách hỏng/mất được tổng hợp hàng năm vào kỳ kiểm kê tháng 12.</p>
                </div>
            </div>

        </div>

    </div>

</div>

<!-- TOAST THÔNG BÁO -->
<div id="settingsToast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
    <div class="bg-navy-900 text-white px-5 py-3.5 rounded-xl shadow-2xl flex items-center gap-3 border border-emerald-500/30">
        <i data-lucide="check-circle" class="w-5 h-5 text-emerald-400"></i>
        <div>
            <h5 class="text-xs font-bold text-white">Đã Lưu Cấu Hình Thành Công!</h5>
            <p class="text-[11px] text-slate-300">Các tham số mượn trả đã được cập nhật vào hệ thống điều hành.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function saveSettings() {
            var toast = document.getElementById('settingsToast');
            toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
            setTimeout(function () {
                toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
            }, 3000);
        }

        document.addEventListener('DOMContentLoaded', function () {
            if (window.lucide) {
                lucide.createIcons();
            }
        });
    </script>
}
