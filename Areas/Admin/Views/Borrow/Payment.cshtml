@model BOOK.Models.ViewModels.PaymentDeskViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quầy Thu Phí Bồi Thường & Mở Khóa Thẻ";
}

<div class="space-y-6">

    <!-- BREADCRUMB & HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <nav class="flex items-center gap-2 text-xs text-slate-500 mb-1">
                <span>Nghiệp vụ Mượn - Trả</span>
                <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-slate-400"></i>
                <span class="text-navy-800 font-bold">Quầy thanh toán bồi thường</span>
            </nav>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2.5">
                <i data-lucide="credit-card" class="w-7 h-7 text-amber-500"></i>
                Quầy Thu Phí Bồi Thường & Mở Khóa Thẻ
            </h1>
            <p class="text-xs text-slate-500 mt-0.5">Xử lý thu tiền bồi thường sách hỏng, mất theo quy chế cố định và kích hoạt lại Thẻ thư viện cho độc giả.</p>
        </div>

        <div class="flex items-center gap-2">
            <a asp-area="Admin" asp-controller="Borrow" asp-action="Return"
               class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5">
                <i data-lucide="scan-barcode" class="w-4 h-4 text-emerald-600"></i> Sang Quầy Nhận Trả Sách
            </a>
            <a asp-area="Admin" asp-controller="Borrow" asp-action="Index"
               class="px-4 py-2 bg-navy-800 hover:bg-navy-900 text-white rounded-xl text-xs font-bold shadow transition-all flex items-center gap-1.5">
                <i data-lucide="arrow-left" class="w-4 h-4"></i> Về Quản Lý Mượn Trả
            </a>
        </div>
    </div>

    <!-- KHUNG TRA CỨU ĐỘC GIẢ NỢ PHÍ -->
    <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-4">
        <form method="get" asp-action="Payment" class="flex flex-col sm:flex-row gap-3 items-center">
            <div class="relative flex-1 w-full">
                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                    <i data-lucide="search" class="w-4 h-4"></i>
                </span>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" required
                       placeholder="Nhập Số thẻ thư viện (VD: LIB-...), Mã số sinh viên (MSSV), hoặc Mã phiếu mượn (VD: 12)..."
                       class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-bold text-slate-900 focus:outline-none focus:border-navy-800 focus:bg-white transition-all shadow-inner" />
            </div>
            <button type="submit"
                    class="w-full sm:w-auto px-6 py-3 bg-amber-500 hover:bg-amber-600 text-navy-950 font-bold text-xs rounded-2xl shadow-md transition-all flex items-center justify-center gap-2">
                <i data-lucide="search" class="w-4 h-4"></i>
                <span>Tra Cứu Bồi Thường</span>
            </button>
        </form>

        <!-- ĐỊNH MỨC BIỂU PHÍ BỒI THƯỜNG QUY ĐỊNH (CỐ ĐỊNH) -->
        <div class="pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between text-xs text-slate-500 gap-2">
            <div class="flex items-center gap-1.5 font-semibold text-slate-700">
                <i data-lucide="shield-alert" class="w-4 h-4 text-amber-500"></i>
                <span>Biểu phí bồi thường quy định cố định (không cho phép sửa tùy tiện):</span>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <span class="px-2.5 py-1 bg-amber-50 text-amber-900 border border-amber-200 rounded-lg font-bold">
                    ⚠️ Sách Hỏng / Rách trang: <strong>50.000 VNĐ/cuốn</strong>
                </span>
                <span class="px-2.5 py-1 bg-rose-50 text-rose-900 border border-rose-200 rounded-lg font-bold">
                    ⛔ Sách Mất / Thất lạc: <strong>100.000 VNĐ/cuốn</strong>
                </span>
                <span class="px-2.5 py-1 bg-blue-50 text-blue-900 border border-blue-200 rounded-lg font-bold">
                    ⏱️ Trễ hạn: <strong>2.000 VNĐ/ngày</strong>
                </span>
            </div>
        </div>
    </div>

    @if (!Model.HasSearched)
    {
        <!-- TRẠNG THÁI CHỜ TRA CỨU -->
        <div class="bg-white p-12 rounded-3xl border border-slate-200 shadow-sm text-center space-y-3">
            <div class="w-16 h-16 rounded-2xl bg-amber-50 text-amber-500 flex items-center justify-center mx-auto shadow-sm">
                <i data-lucide="banknote" class="w-8 h-8"></i>
            </div>
            <h3 class="text-base font-bold text-slate-800">Quầy Tiếp Nhận & Thu Phạt Bồi Thường</h3>
            <p class="text-xs text-slate-500 max-w-md mx-auto leading-relaxed">
                Vui lòng nhập Số thẻ thư viện hoặc MSSV của sinh viên đến quầy để kiểm tra các khoản bồi thường chưa hoàn tất và thực hiện thu tiền mở lại thẻ.
            </p>
        </div>
    }
    else if (!Model.CardFound)
    {
        <!-- KHÔNG TÌM THẤY ĐỘC GIẢ -->
        <div class="bg-white p-10 rounded-3xl border border-slate-200 shadow-sm text-center space-y-3">
            <div class="w-14 h-14 rounded-2xl bg-rose-50 text-rose-500 flex items-center justify-center mx-auto">
                <i data-lucide="user-x" class="w-7 h-7"></i>
            </div>
            <h3 class="text-sm font-bold text-rose-900">Không Tìm Thấy Hồ Sơ Độc Giả</h3>
            <p class="text-xs text-slate-500">
                Không tìm thấy thẻ thư viện hoặc phiếu mượn tương ứng với từ khóa "<strong>@Model.SearchTerm</strong>". Vui lòng kiểm tra lại số thẻ hoặc MSSV.
            </p>
        </div>
    }
    else
    {
        <!-- KẾT QUẢ TRA CỨU HỒ SƠ ĐỘC GIẢ -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- CỘT TRÁI: THẺ THÔNG TIN ĐỘC GIẢ -->
            <div class="lg:col-span-4 space-y-4">
                <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-4">
                    <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
                        <div class="w-12 h-12 rounded-2xl bg-navy-900 text-amber-400 flex items-center justify-center font-black text-lg">
                            @(Model.StudentName.Length > 0 ? Model.StudentName.Substring(0, 1) : "S")
                        </div>
                        <div>
                            <h3 class="font-extrabold text-sm text-slate-900 uppercase">@Model.StudentName</h3>
                            <p class="text-xs text-slate-500">MSSV: <strong class="font-mono text-navy-800">@Model.StudentCode</strong></p>
                        </div>
                    </div>

                    <div class="space-y-2.5 text-xs">
                        <div class="flex items-center justify-between">
                            <span class="text-slate-500">Số Thẻ Thư Viện:</span>
                            <span class="font-mono font-bold text-navy-900">@Model.CardNumber</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-slate-500">Hạn Hiệu Lực Thẻ:</span>
                            <span class="font-semibold text-slate-700">@Model.CardExpiryDate.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="flex items-center justify-between pt-2 border-t border-slate-100">
                            <span class="text-slate-500">Trạng Thái Thẻ:</span>
                            @if (Model.CardStatus == "Sử dụng được")
                            {
                                <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                                    ✓ Sử dụng được
                                </span>
                            }
                            else
                            {
                                <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-rose-100 text-rose-800 border border-rose-200 animate-pulse">
                                    ⛔ Không sử dụng (Bị khóa)
                                </span>
                            }
                        </div>
                    </div>

                    @if (Model.CardStatus != "Sử dụng được")
                    {
                        <div class="p-3 bg-rose-50 border border-rose-200 rounded-2xl text-[11px] text-rose-900 space-y-1">
                            <p class="font-bold">⚠️ Ràng buộc khóa thẻ:</p>
                            <p>Thẻ độc giả đang bị vô hiệu hóa do có sách hỏng hoặc mất chưa hoàn tất nghĩa vụ bồi thường. Sau khi thu đủ tiền tại quầy, hệ thống sẽ tự động mở lại trạng thái <strong>[Sử dụng được]</strong>.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- CỘT PHẢI: DANH SÁCH KHOẢN PHẠT CẦN THU -->
            <div class="lg:col-span-8 space-y-4">
                @if (Model.UnpaidFines == null || !Model.UnpaidFines.Any())
                {
                    <div class="bg-white p-8 rounded-3xl border border-emerald-200 shadow-sm text-center space-y-3">
                        <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto">
                            <i data-lucide="check-circle-2" class="w-8 h-8"></i>
                        </div>
                        <h3 class="text-base font-bold text-emerald-950">Không Có Khoản Phạt Nào Tồn Đọng</h3>
                        <p class="text-xs text-slate-500 max-w-md mx-auto">
                            Độc giả <strong>@Model.StudentName</strong> hiện không có sách hỏng, mất hoặc khoản nợ nào trong hệ thống. Thẻ thư viện hoàn toàn hợp lệ để mượn sách.
                        </p>
                    </div>
                }
                else
                {
                    <form method="post" asp-action="ProcessPayment" class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-5">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="cardNumber" value="@Model.CardNumber" />

                        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                            <div>
                                <h3 class="font-bold text-sm text-slate-900 flex items-center gap-2">
                                    <i data-lucide="list-checks" class="w-4 h-4 text-amber-500"></i>
                                    Danh Mục Các Khoản Phạt / Bồi Thường Cần Thu
                                </h3>
                                <p class="text-[11px] text-slate-400">Tích chọn các khoản độc giả nộp tiền tại quầy để thanh toán</p>
                            </div>
                            <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-900">
                                @Model.UnpaidFines.Count khoản cần thu
                            </span>
                        </div>

                        <div class="overflow-x-auto rounded-2xl border border-slate-200">
                            <table class="w-full text-left text-xs text-slate-600">
                                <thead class="bg-slate-50 text-slate-500 uppercase font-bold border-b border-slate-200 text-[11px]">
                                    <tr>
                                        <th class="py-3 px-4 w-10 text-center">
                                            <input type="checkbox" id="selectAllFines" checked onchange="toggleAllFines(this)" class="w-4 h-4 rounded text-blue-600" />
                                        </th>
                                        <th class="py-3 px-4">Mã Phiếu</th>
                                        <th class="py-3 px-4">Tên Sách & Mã Sách</th>
                                        <th class="py-3 px-4 text-center">Số KS</th>
                                        <th class="py-3 px-4">Loại Sự Cố</th>
                                        <th class="py-3 px-4 text-right">Mức Bồi Thường</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-200">
                                    @foreach (var fine in Model.UnpaidFines)
                                    {
                                        <tr class="hover:bg-slate-50 transition-colors">
                                            <td class="py-3.5 px-4 text-center">
                                                <input type="checkbox" name="chiTietIds" value="@fine.ChiTietId" checked 
                                                       data-amount="@fine.FineAmount" onchange="recalculateTotal()"
                                                       class="fine-checkbox w-4 h-4 rounded text-blue-600 cursor-pointer" />
                                            </td>
                                            <td class="py-3.5 px-4 font-mono font-bold text-navy-800">
                                                PM-@fine.PhieuMuonId.ToString("D4")
                                            </td>
                                            <td class="py-3.5 px-4 max-w-xs font-semibold text-slate-900">
                                                <p class="truncate">@fine.BookTitle</p>
                                                <span class="text-[10px] text-slate-400 font-mono font-normal">Mã: @fine.BookCode</span>
                                            </td>
                                            <td class="py-3.5 px-4 text-center font-mono font-black text-navy-900">
                                                [@fine.ControlNumber]
                                            </td>
                                            <td class="py-3.5 px-4">
                                                @if (fine.IncidentType == "Mất")
                                                {
                                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 border border-rose-200">
                                                        ⛔ Mất sách
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200">
                                                        ⚠️ Hỏng sách
                                                    </span>
                                                }
                                            </td>
                                            <td class="py-3.5 px-4 text-right font-black text-rose-600 font-mono">
                                                @fine.FineAmount.ToString("N0") VNĐ
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- KHUNG TỔNG TIỀN & XÁC NHẬN THU TIỀN -->
                        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                            <div class="space-y-1">
                                <span class="text-xs text-slate-500 uppercase font-bold tracking-wider">Tổng tiền bồi thường cần thu:</span>
                                <div class="text-2xl font-black text-rose-600 font-mono" id="displayTotal">
                                    @Model.TotalAmount.ToString("N0") VNĐ
                                </div>
                                <p class="text-[11px] text-slate-400">Mức phí áp dụng theo đúng quy chế ban hành của Nhà trường.</p>
                            </div>

                            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                                <div>
                                    <label class="block text-[11px] font-bold text-slate-600 mb-1">Hình thức thanh toán:</label>
                                    <select name="paymentMethod" class="py-2 px-3 bg-white border border-slate-200 rounded-xl text-xs font-bold text-slate-900 focus:outline-none">
                                        <option value="Tiền mặt tại quầy" selected>💵 Tiền mặt tại quầy</option>
                                        <option value="Chuyển khoản QR ngân hàng">📱 Chuyển khoản QR ngân hàng</option>
                                        <option value="Trừ thẻ sinh viên">💳 Thẻ sinh viên tích hợp</option>
                                    </select>
                                </div>

                                <button type="submit"
                                        class="px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-2xl font-bold text-xs shadow-lg shadow-emerald-900/20 transition-all flex items-center justify-center gap-2 cursor-pointer mt-auto">
                                    <i data-lucide="check-circle" class="w-4 h-4"></i>
                                    <span>Xác Nhận Đã Thu & Mở Khóa Thẻ</span>
                                </button>
                            </div>
                        </div>
                    </form>
                }
            </div>

        </div>
    }

</div>

@section Scripts {
    <script>
        function toggleAllFines(masterCb) {
            const cbs = document.querySelectorAll('.fine-checkbox');
            cbs.forEach(cb => cb.checked = masterCb.checked);
            recalculateTotal();
        }

        function recalculateTotal() {
            let total = 0;
            const cbs = document.querySelectorAll('.fine-checkbox:checked');
            cbs.forEach(cb => {
                total += parseFloat(cb.getAttribute('data-amount') || '0');
            });
            const display = document.getElementById('displayTotal');
            if (display) {
                display.innerText = new Intl.NumberFormat('vi-VN').format(total) + ' VNĐ';
            }
        }
    </script>
}
