@model BOOK.Models.ViewModels.ReturnBookDeskViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quầy Thu Hồi & Đánh Giá Tình Trạng Tài Liệu";
}

<div class="space-y-6">

    <!-- BREADCRUMB & HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <nav class="flex items-center gap-2 text-xs text-slate-500 mb-1">
                <span>Nghiệp Vụ Mượn - Trả</span>
                <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-slate-400"></i>
                <span class="text-navy-800 font-bold">Quầy Thu Hồi & Đánh Giá</span>
            </nav>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">Quầy Thu Hồi & Đánh Giá Tình Trạng Tài Liệu</h1>
            <p class="text-xs text-slate-500 mt-0.5">Tiếp nhận sách vật lý từ độc giả, kiểm tra tình trạng từng cuốn theo số kiểm soát và tính phí bồi thường (nếu có).</p>
        </div>

        <a asp-action="Index" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 self-start">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Quay Lại Danh Sách Mượn Trả
        </a>
    </div>

    <!-- TÌM KIẾM PHIẾU MƯỢN CẦN TRẢ -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
        <form method="get" asp-action="Return" class="max-w-2xl">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                Nhập Mã Số Phiếu Mượn Hoặc Quét Mã Vạch
            </label>
            <div class="flex gap-2">
                <div class="relative flex-1">
                    <input type="number" name="ticketCode" value="@(string.IsNullOrEmpty(Model.TicketCode) ? "" : Model.TicketCode)" 
                           placeholder="Ví dụ: 1, 2, 3... (nhập số phiếu mượn)" 
                           class="w-full pl-10 pr-3 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-navy-800 focus:outline-none font-mono" />
                    <i data-lucide="scan" class="w-5 h-5 text-slate-400 absolute left-3 top-3"></i>
                </div>
                <button type="submit" class="px-6 py-2.5 bg-navy-800 hover:bg-navy-900 text-white rounded-xl text-xs font-bold transition-colors flex items-center gap-1.5 shadow-sm">
                    <i data-lucide="search" class="w-4 h-4"></i> Tra Cứu Phiếu
                </button>
            </div>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(Model.StudentName))
    {
        <!-- THÔNG TIN ĐỘC GIẢ & THẺ THƯ VIỆN -->
        <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-slate-100">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-2xl bg-navy-800 text-white flex items-center justify-center font-bold text-base shadow">
                        @(Model.StudentName.Length > 0 ? Model.StudentName.Substring(0, 1).ToUpper() : "Đ")
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h3 class="font-extrabold text-slate-900 text-base">@Model.StudentName</h3>
                            <span class="px-2 py-0.5 rounded-full text-xs font-mono font-bold bg-slate-100 text-slate-700">MSSV: @Model.StudentCode</span>
                        </div>
                        <p class="text-xs text-slate-500 mt-0.5">Số thẻ thư viện: <strong class="font-mono text-navy-800">@Model.CardNumber</strong> | Hạn thẻ: @Model.CardExpiryDate.ToString("dd/MM/yyyy")</p>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <span class="text-xs text-slate-500">Tình trạng thẻ:</span>
                    @if (Model.CurrentCardStatus == "Sử dụng được")
                    {
                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span> @Model.CurrentCardStatus
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                            <span class="w-2 h-2 rounded-full bg-rose-500"></span> @Model.CurrentCardStatus (Đang bị khóa)
                        </span>
                        <button type="button" onclick="confirmCounterPayment('@Model.CardNumber')" 
                                class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold shadow transition-colors flex items-center gap-1.5 cursor-pointer">
                            <i data-lucide="check-circle" class="w-3.5 h-3.5"></i> Đã Thu Phạt & Mở Khóa Thẻ
                        </button>
                    }
                </div>
            </div>

            <!-- QUY TẮC NGHIỆP VỤ BẮT BUỘC -->
            <div class="mt-4 p-3.5 bg-amber-50 rounded-2xl border border-amber-200 text-xs text-amber-900 flex items-start gap-2.5">
                <i data-lucide="alert-circle" class="w-4 h-4 text-amber-600 flex-shrink-0 mt-0.5"></i>
                <div class="space-y-0.5">
                    <p class="font-bold">Quy định bồi thường tài liệu tại quầy:</p>
                    <p class="text-[11px] text-amber-800">
                        • Nếu sách có sự cố "Hỏng" hoặc "Mất", Thủ thư ghi nhận mức phí bồi thường. Nếu sinh viên nộp tiền ngay tại quầy, hãy tích chọn <strong>"Đã thu tiền tại quầy"</strong> để thẻ sinh viên không bị khóa.
                    </p>
                </div>
            </div>
        </div>

        <!-- FORM GHI NHẬN TÌNH TRẠNG SÁCH & BỒI THƯỜNG -->
        <form method="post" asp-action="Return" class="space-y-4 bg-white p-6 rounded-3xl border border-slate-200 shadow-sm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="phieuMuonId" value="@Model.TicketCode" />

            <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                <h3 class="font-extrabold text-sm text-slate-900 flex items-center gap-2">
                    <i data-lucide="book-check" class="w-4 h-4 text-emerald-600"></i>
                    Danh Mục Cuốn Sách Trong Phiếu Mượn (#@Model.TicketCode)
                </h3>
                <span class="text-xs text-slate-500">Số lượng: <strong>@Model.BorrowedCopies.Count cuốn</strong></span>
            </div>

            <div class="overflow-x-auto rounded-2xl border border-slate-200">
                <table class="w-full text-left text-xs text-slate-600">
                    <thead class="bg-slate-50 text-slate-500 uppercase font-bold border-b border-slate-200">
                        <tr>
                            <th class="py-3 px-4">Tên Sách</th>
                            <th class="py-3 px-4">Số Kiểm Soát</th>
                            <th class="py-3 px-4">Hạn Trả &amp; Trễ Hạn</th>
                            <th class="py-3 px-4">Tình Trạng Khi Nhận Lại</th>
                            <th class="py-3 px-4">Phí Hư Hỏng / Mất (VNĐ)</th>
                            <th class="py-3 px-4 text-center">Thu Tiền Tại Quầy</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200">
                        @for (int i = 0; i < Model.BorrowedCopies.Count; i++)
                        {
                            var item = Model.BorrowedCopies[i];
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="py-3.5 px-4 font-bold text-slate-900 max-w-xs">
                                    <p class="truncate">@item.BookTitle</p>
                                    <span class="text-[10px] text-slate-400 font-mono font-normal">Mã: @item.BookCode</span>
                                </td>
                                <td class="py-3.5 px-4 font-mono font-black text-sm text-navy-800">
                                    @item.ControlNumber
                                </td>
                                <td class="py-3.5 px-4 text-slate-500">
                                    <div>@item.DueDate.ToString("dd/MM/yyyy")</div>
                                    @if (item.OverdueDays > 0)
                                    {
                                        <span class="inline-block mt-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 border border-rose-200">
                                            Trễ @item.OverdueDays ngày (+@item.LateFee.ToString("N0")đ)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-block mt-1 text-[10px] text-emerald-700 font-semibold">Trong hạn</span>
                                    }
                                </td>
                                <td class="py-3.5 px-4">
                                    <input type="hidden" name="copyIds" value="@item.CopyId" />
                                    <select name="conditions" onchange="handleConditionChange(this, @i)" 
                                            class="py-2 px-3 bg-slate-50 border border-slate-200 rounded-xl font-bold text-xs focus:bg-white focus:border-navy-800 focus:outline-none">
                                        <option value="Bình thường" selected>✓ Còn nguyên vẹn (Bình thường)</option>
                                        <option value="Hỏng">⚠️ Hư hỏng / Rách trang (Hỏng)</option>
                                        <option value="Mất">⛔ Thất lạc / Làm mất (Mất)</option>
                                    </select>
                                </td>
                                <td class="py-3.5 px-4">
                                    <div class="relative w-44">
                                        <input type="number" id="feeInput_@i" name="fees" value="0" data-late-fee="@item.LateFee.ToString(System.Globalization.CultureInfo.InvariantCulture)" readonly
                                               class="return-fee-input w-full py-2 px-3 bg-slate-100 border border-slate-200 rounded-xl font-bold text-xs text-rose-600 focus:outline-none cursor-not-allowed" />
                                        <span class="absolute right-3 top-2 text-[10px] text-slate-400 pointer-events-none">đ (Quy chế)</span>
                                    </div>
                                    <p id="rowTotalLabel_@i" class="text-[10px] font-bold mt-1 @(item.LateFee > 0 ? "text-rose-600" : "text-slate-400")">
                                        Tổng cuốn này: @item.LateFee.ToString("N0") VNĐ
                                    </p>
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    <label class="inline-flex items-center gap-1.5 cursor-pointer bg-slate-50 hover:bg-emerald-50 px-2.5 py-1.5 rounded-lg border border-slate-200 transition-colors">
                                        <input type="checkbox" name="paidStatuses" value="@i" id="paidCheckbox_@i" class="w-4 h-4 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500 cursor-pointer" />
                                        <span class="text-[11px] font-bold text-slate-700">Đã thu tiền</span>
                                    </label>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-wrap items-center gap-3">
                    <span class="text-xs text-slate-500">Tổng tiền phạt / bồi thường phiếu:</span>
                    <span id="returnDeskTotalFine" class="text-lg font-black font-mono text-rose-600">0 VNĐ</span>
                    <button type="button" id="btnShowReturnQr" onclick="openReturnQrModal()"
                            class="hidden px-3.5 py-2 bg-navy-800 hover:bg-navy-900 text-white rounded-xl text-xs font-bold shadow-sm transition-all flex items-center gap-1.5 cursor-pointer">
                        <i data-lucide="qr-code" class="w-4 h-4 text-amber-400"></i> Tạo Mã QR Thu Phạt
                    </button>
                </div>
                <button type="submit" class="px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold shadow-md hover:shadow-lg transition-all flex items-center gap-2">
                    <i data-lucide="check-check" class="w-4 h-4"></i> Xác Nhận Nhập Trả Vào Kho
                </button>
            </div>
        </form>

        <!-- MODAL QR THU PHẠT NGAY TẠI QUẦY TRẢ SÁCH -->
        <div id="returnQrModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-navy-950/70 backdrop-blur-sm">
            <div class="bg-white rounded-3xl shadow-2xl border border-slate-200 max-w-md w-full overflow-hidden">
                <div class="bg-navy-900 text-white p-5 flex items-center justify-between">
                    <h3 class="font-bold text-sm flex items-center gap-2">
                        <i data-lucide="qr-code" class="w-5 h-5 text-amber-400"></i> Mã QR Thanh Toán Phạt Tại Quầy
                    </h3>
                    <button type="button" onclick="document.getElementById('returnQrModal').classList.add('hidden')" class="text-slate-400 hover:text-white p-1">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>
                </div>
                <div class="p-6 space-y-4 text-xs text-center">
                    <div class="flex items-center justify-between bg-slate-50 p-3 rounded-2xl border border-slate-200">
                        <span class="font-bold text-slate-600">Tổng tiền phạt:</span>
                        <span id="returnQrAmount" class="text-lg font-black font-mono text-rose-600">0 VNĐ</span>
                    </div>
                    <span id="returnQrTierBadge" class="inline-block px-3 py-1 rounded-full text-[11px] font-bold border"></span>
                    <div class="bg-white p-3 rounded-2xl border border-slate-200 shadow-inner w-52 h-52 mx-auto flex items-center justify-center">
                        <img id="returnQrImg" src="" alt="QR Thanh Toán" class="w-full h-full object-contain" />
                    </div>
                    <div class="bg-slate-50 rounded-2xl p-3 border border-slate-200 text-left space-y-1.5">
                        <div class="flex justify-between"><span class="text-slate-500">Ngân hàng:</span><strong id="returnQrBank">Vietcombank</strong></div>
                        <div class="flex justify-between"><span class="text-slate-500">Số TK:</span><strong id="returnQrAcc" class="font-mono text-navy-900">102888666999</strong></div>
                        <div class="flex justify-between"><span class="text-slate-500">Nội dung CK:</span><strong id="returnQrMemo" class="font-mono text-emerald-700"></strong></div>
                    </div>
                    <p class="text-[11px] text-slate-500">Sau khi sinh viên quét mã thanh toán, vui lòng tích <strong>"Đã thu tiền"</strong> ở các dòng tương ứng rồi bấm Xác Nhận Nhập Trả.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- EMPTY STATE KHI CHƯA CHỌN PHIẾU HOẶC KHÔNG TÌM THẤY -->
        <div class="p-12 text-center bg-white rounded-3xl border border-slate-200 shadow-sm">
            <div class="w-16 h-16 rounded-full bg-blue-50 text-navy-800 flex items-center justify-center mx-auto mb-3">
                <i data-lucide="scan-barcode" class="w-8 h-8"></i>
            </div>
            <h3 class="font-extrabold text-slate-800 text-base">Chưa Chọn Phiếu Mượn Cần Tiếp Nhận</h3>
            <p class="text-xs text-slate-500 mt-1 max-w-md mx-auto">
                Vui lòng nhập mã số phiếu mượn vào ô tìm kiếm ở trên hoặc truy cập danh sách các phiếu đang mượn để chọn nhanh phiếu cần hoàn trả.
            </p>
            <div class="mt-5">
                <a asp-action="Index" class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-navy-800 hover:bg-navy-900 text-white rounded-xl text-xs font-bold transition-all shadow-sm">
                    <i data-lucide="list" class="w-4 h-4 text-amber-400"></i> Xem Danh Sách Phiếu Đang Mượn
                </a>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script>
        function getReturnTotalFine() {
            let total = 0;
            document.querySelectorAll('.return-fee-input').forEach((inp, idx) => {
                const base = parseFloat(inp.value || '0');
                const late = parseFloat(inp.getAttribute('data-late-fee') || '0');
                const rowSum = base + late;
                total += rowSum;
                const rowLabel = document.getElementById('rowTotalLabel_' + idx);
                if (rowLabel) {
                    rowLabel.textContent = 'Tổng cuốn này: ' + new Intl.NumberFormat('vi-VN').format(rowSum) + ' VNĐ';
                    rowLabel.className = 'text-[10px] font-bold mt-1 ' + (rowSum > 0 ? 'text-rose-600' : 'text-slate-400');
                }
            });

            const totalEl = document.getElementById('returnDeskTotalFine');
            const qrBtn = document.getElementById('btnShowReturnQr');
            if (totalEl) totalEl.textContent = new Intl.NumberFormat('vi-VN').format(total) + ' VNĐ';
            if (qrBtn) {
                if (total > 0) qrBtn.classList.remove('hidden');
                else qrBtn.classList.add('hidden');
            }
            return total;
        }

        function handleConditionChange(selectEl, index) {
            const feeInput = document.getElementById('feeInput_' + index);
            const paidCb = document.getElementById('paidCheckbox_' + index);
            if (!feeInput) return;

            if (selectEl.value === 'Hỏng') {
                feeInput.value = 50000;
            } else if (selectEl.value === 'Mất') {
                feeInput.value = 100000;
            } else {
                feeInput.value = 0;
                if (paidCb && parseFloat(feeInput.getAttribute('data-late-fee') || '0') <= 0) {
                    paidCb.checked = false;
                }
            }
            getReturnTotalFine();
        }

        async function openReturnQrModal() {
            const total = getReturnTotalFine();
            if (total <= 0) return;

            const studentCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StudentCode));
            const cardNumber = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CardNumber));
            const ticketCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize("PM" + Model.TicketCode));

            try {
                const res = await fetch(`/Qr/FineInfo?amount=${encodeURIComponent(total)}&studentCode=${encodeURIComponent(studentCode)}&cardNumber=${encodeURIComponent(cardNumber)}&reference=${encodeURIComponent(ticketCode)}`);
                const data = await res.json();
                if (!res.ok || !data.success) return;

                document.getElementById('returnQrAmount').textContent = data.formattedAmount;
                document.getElementById('returnQrImg').src = data.qrImageUrl + '&_t=' + Date.now();
                document.getElementById('returnQrBank').textContent = data.bankName;
                document.getElementById('returnQrAcc').textContent = data.accountNumber;
                document.getElementById('returnQrMemo').textContent = data.transferContent;

                const badge = document.getElementById('returnQrTierBadge');
                badge.textContent = data.tierName;
                badge.className = 'inline-block px-3 py-1 rounded-full text-[11px] font-bold border ' + data.tierBadgeClass;

                document.getElementById('returnQrModal')?.classList.remove('hidden');
                if (window.lucide) lucide.createIcons();
            } catch (e) {
                alert('Không thể tạo mã QR thanh toán: ' + e.message);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            getReturnTotalFine();
        });

        async function confirmCounterPayment(cardNumber) {
            if (!confirm(`Xác nhận đã thu toàn bộ phí bồi thường và kích hoạt lại thẻ ${cardNumber}?`)) return;
            try {
                const res = await fetch(`/Admin/Borrow/ConfirmCounterPayment?cardNumber=${encodeURIComponent(cardNumber)}`, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await res.json();
                if (data.success) {
                    if (typeof window.showAppToast === 'function') {
                        window.showAppToast('success', 'Thành công', data.message);
                    } else {
                        alert(data.message);
                    }
                    setTimeout(() => location.reload(), 700);
                } else {
                    if (typeof window.showAppToast === 'function') {
                        window.showAppToast('error', 'Lỗi', data.message);
                    } else {
                        alert(data.message);
                    }
                }
            } catch (err) {
                alert('Lỗi kết nối: ' + err.message);
            }
        }
    </script>
}