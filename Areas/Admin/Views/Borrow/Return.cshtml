@model BOOK.Models.ViewModels.ReturnBookDeskViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Tiếp Nhận Trả Sách";
}

<div class="space-y-6">
    <h1 class="text-2xl font-black text-slate-900">Quầy Nhận Trả Sách</h1>

    @if (TempData["Error"] != null)
    {
        <div class="p-3 rounded-xl bg-rose-100 text-rose-800 text-sm font-bold">@TempData["Error"]</div>
    }

    <form method="get" asp-action="Return" class="flex gap-3">
        <input type="number" name="ticketCode" placeholder="Nhập mã phiếu mượn (số)" class="flex-1 p-2.5 border border-slate-300 rounded-xl font-mono" />
        <button type="submit" class="px-4 py-2.5 bg-navy-800 text-white rounded-xl text-xs font-bold">Tra Cứu Phiếu</button>
    </form>

    @if (!string.IsNullOrEmpty(Model.StudentName))
    {
        <div class="bg-white rounded-2xl border border-slate-200 p-4">
            <p><strong>@Model.StudentName</strong> — MSSV @Model.StudentCode — Thẻ @Model.CardNumber</p>
        </div>

        <form method="post" asp-action="Return" class="space-y-4 bg-white p-6 rounded-2xl border border-slate-200">
            @Html.AntiForgeryToken()
            <input type="hidden" name="phieuMuonId" value="@Model.TicketCode" />

            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left border-b">
                        <th class="py-2">Sách</th>
                        <th>Số KS</th>
                        <th>Tình trạng khi trả</th>
                        <th>Tiền bồi thường</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.BorrowedCopies)
                    {
                        <tr class="border-b">
                            <td class="py-2">@item.BookTitle</td>
                            <td>@item.ControlNumber</td>
                            <td>
                                <input type="hidden" name="copyIds" value="@item.CopyId" />
                                <select name="conditions" class="p-1.5 border border-slate-300 rounded-lg">
                                    <option value="Bình thường">Bình thường</option>
                                    <option value="Hỏng">Hỏng</option>
                                    <option value="Mất">Mất</option>
                                </select>
                            </td>
                            <td><input type="number" name="fees" value="0" class="p-1.5 border border-slate-300 rounded-lg w-28" /></td>
                        </tr>
                    }
                </tbody>
            </table>

            <button type="submit" class="px-6 py-3 bg-navy-800 text-white rounded-xl font-bold">Xác Nhận Trả Sách</button>
        </form>
    }
</div>