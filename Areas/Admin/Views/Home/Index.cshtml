@model BOOK.Models.ViewModels.AdminDashboardViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Tổng Quan Hệ Thống Thư Viện";
}

<div class="space-y-8">

    <!-- TOP BREADCRUMBS & ACTION -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <nav class="flex items-center gap-2 text-xs text-slate-500 mb-1">
                <span>Khu vực quản trị</span>
                <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-slate-400"></i>
                <span class="text-navy-800 font-bold">Tổng quan Dashboard</span>
            </nav>
            <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Trung Tâm Điều Hành Thư Viện</h1>
        </div>

        <div class="flex items-center gap-3">
            <span class="text-xs text-slate-500 hidden sm:inline">Cập nhật lúc: <strong>@DateTime.Now.ToString("HH:mm - dd/MM/yyyy")</strong></span>
            <a asp-area="Admin" asp-controller="Borrow" asp-action="Index" 
               class="px-4 py-2.5 bg-navy-800 hover:bg-navy-900 text-white rounded-xl text-xs font-bold shadow-md hover:shadow-lg transition-all flex items-center gap-2">
                <i data-lucide="arrow-left-right" class="w-4 h-4 text-amber-400"></i> Quầy Mượn Trả
            </a>
        </div>
    </div>

    <!-- 4 THẺ KPI THỐNG KÊ TRÊN CÙNG -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <!-- KPI 1: Tổng số đầu sách & bản sao -->
        <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm hover:shadow-md transition-all space-y-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Kho Sách & Bản Sao</span>
                <div class="w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center">
                    <i data-lucide="book-copy" class="w-5 h-5"></i>
                </div>
            </div>
            <div>
                <h3 class="text-2xl sm:text-3xl font-black text-slate-900">@Model.KpiTotalBooks.Value</h3>
                <p class="text-xs text-slate-500 mt-0.5">@Model.KpiTotalBooks.Subtext</p>
            </div>
            <div class="pt-2 border-t border-slate-100 flex items-center gap-1.5 text-xs text-emerald-600 font-bold">
                <i data-lucide="trending-up" class="w-4 h-4"></i>
                <span>@Model.KpiTotalBooks.ChangeText</span>
                <span class="text-slate-400 font-normal">so với tháng trước</span>
            </div>
        </div>

        <!-- KPI 2: Sách đang được mượn -->
        <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm hover:shadow-md transition-all space-y-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Đang Lưu Thông</span>
                <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                    <i data-lucide="book-open" class="w-5 h-5"></i>
                </div>
            </div>
            <div>
                <h3 class="text-2xl sm:text-3xl font-black text-slate-900">@Model.KpiActiveBorrows.Value</h3>
                <p class="text-xs text-slate-500 mt-0.5">@Model.KpiActiveBorrows.Subtext</p>
            </div>
            <div class="pt-2 border-t border-slate-100 flex items-center gap-1.5 text-xs text-emerald-600 font-bold">
                <i data-lucide="trending-up" class="w-4 h-4"></i>
                <span>@Model.KpiActiveBorrows.ChangeText</span>
                <span class="text-slate-400 font-normal">so với tháng trước</span>
            </div>
        </div>

        <!-- KPI 3: Phiếu mượn chờ duyệt (Màu vàng cảnh báo) -->
        <div class="bg-white rounded-3xl border border-amber-200 p-6 shadow-sm hover:shadow-md transition-all space-y-3 bg-gradient-to-br from-white to-amber-50/40">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-amber-700 uppercase tracking-wider">Yêu Cầu Chờ Duyệt</span>
                <div class="w-10 h-10 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center">
                    <i data-lucide="clock-arrow-up" class="w-5 h-5"></i>
                </div>
            </div>
            <div>
                <h3 class="text-2xl sm:text-3xl font-black text-amber-600">@Model.KpiPendingBorrows.Value</h3>
                <p class="text-xs text-slate-500 mt-0.5">@Model.KpiPendingBorrows.Subtext</p>
            </div>
            <div class="pt-2 border-t border-amber-100 flex items-center gap-1 text-xs text-amber-700 font-bold">
                <i data-lucide="alert-circle" class="w-4 h-4"></i>
                <span>@Model.KpiPendingBorrows.ChangeText</span>
            </div>
        </div>

        <!-- KPI 4: Sách quá hạn chưa trả (Màu đỏ cảnh báo) -->
        <div class="bg-white rounded-3xl border border-rose-200 p-6 shadow-sm hover:shadow-md transition-all space-y-3 bg-gradient-to-br from-white to-rose-50/40">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-rose-700 uppercase tracking-wider">Quá Hạn Chưa Trả</span>
                <div class="w-10 h-10 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center">
                    <i data-lucide="alert-octagon" class="w-5 h-5"></i>
                </div>
            </div>
            <div>
                <h3 class="text-2xl sm:text-3xl font-black text-rose-600">@Model.KpiOverdueBooks.Value</h3>
                <p class="text-xs text-slate-500 mt-0.5">@Model.KpiOverdueBooks.Subtext</p>
            </div>
            <div class="pt-2 border-t border-rose-100 flex items-center gap-1 text-xs text-rose-700 font-bold">
                <i data-lucide="shield-alert" class="w-4 h-4"></i>
                <span>@Model.KpiOverdueBooks.ChangeText</span>
            </div>
        </div>
    </div>

    <!-- KHU VỰC BIỂU ĐỒ (CHART.JS) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Biểu đồ Đường: Xu Hướng Mượn & Trả 12 Tháng Qua -->
        <div class="lg:col-span-8 bg-white rounded-3xl border border-slate-200 p-6 shadow-sm space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2 border-b border-slate-100">
                <div>
                    <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                        <i data-lucide="line-chart" class="w-5 h-5 text-navy-800"></i>
                        Xu Hướng Mượn & Trả Sách (12 Tháng Qua)
                    </h3>
                    <p class="text-xs text-slate-400">Thống kê số lượt bạn đọc mượn và hoàn trả tài liệu theo tháng</p>
                </div>
                <div class="flex items-center gap-3 text-xs">
                    <span class="flex items-center gap-1.5 text-navy-800 font-semibold">
                        <span class="w-3 h-3 rounded-full bg-navy-800"></span> Lượt Mượn
                    </span>
                    <span class="flex items-center gap-1.5 text-emerald-600 font-semibold">
                        <span class="w-3 h-3 rounded-full bg-emerald-500"></span> Lượt Trả
                    </span>
                </div>
            </div>

            <div class="relative h-72 sm:h-80 w-full">
                <canvas id="borrowTrendChart"></canvas>
            </div>
        </div>

        <!-- Biểu đồ Tròn: Tỷ Lệ Sách Theo Thể Loại -->
        <div class="lg:col-span-4 bg-white rounded-3xl border border-slate-200 p-6 shadow-sm space-y-4 flex flex-col justify-between">
            <div class="pb-2 border-b border-slate-100">
                <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <i data-lucide="pie-chart" class="w-5 h-5 text-blue-600"></i>
                    Cơ Cấu Sách Theo Chuyên Ngành
                </h3>
                <p class="text-xs text-slate-400">Tỷ lệ phân bổ đầu sách trong kho</p>
            </div>

            <div class="relative h-64 flex items-center justify-center">
                <canvas id="categoryDistributionChart"></canvas>
            </div>

            <div class="pt-2 flex flex-wrap gap-2 text-[11px] text-slate-600 border-t border-slate-100">
                @for (int i = 0; i < Math.Min(Model.CategoryLabels.Count, 4); i++)
                {
                    var colors = new[] { "bg-blue-600", "bg-emerald-500", "bg-amber-500", "bg-indigo-500" };
                    var color = colors[i % colors.Length];
                    <div class="flex items-center gap-1.5 bg-slate-50 px-2 py-1 rounded-lg">
                        <span class="w-2.5 h-2.5 rounded-full @color"></span>
                        <span class="font-medium text-slate-700">@Model.CategoryLabels[i]:</span>
                        <strong class="text-navy-900">@(i < Model.CategoryBookCounts.Count ? Model.CategoryBookCounts[i] : 0)</strong>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- LUỒNG NGHIỆP VỤ LƯU THÔNG SÁCH CHUẨN THƯ VIỆN HUFLIT (THEO QUY TRÌNH 4 BƯỚC) -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-100">
            <div>
                <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <i data-lucide="git-pull-request" class="w-5 h-5 text-blue-600"></i>
                    Quy Trình Nghiệp Vụ Mượn - Trả - Bồi Thường Sách Chuẩn
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">Vận hành đồng bộ theo 4 mắt xích: Sinh viên mượn → Duyệt yêu cầu → In phiếu → Tiếp nhận trả → Thu phạt bồi thường</p>
            </div>
            <div class="flex items-center gap-2">
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span> Hệ thống đang vận hành
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            
            <!-- BƯỚC 1 -->
            <div class="p-5 rounded-2xl border border-blue-200 bg-blue-50/50 hover:bg-blue-50 transition-all flex flex-col justify-between space-y-4">
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="w-8 h-8 rounded-xl bg-blue-600 text-white font-black text-sm flex items-center justify-center shadow-sm">1</span>
                        @if (Model.PendingBorrowsCount > 0)
                        {
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-400 text-navy-900 animate-pulse">
                                @Model.PendingBorrowsCount chờ duyệt
                            </span>
                        }
                    </div>
                    <h4 class="font-bold text-sm text-navy-950">Phê Duyệt Mượn Trực Tuyến</h4>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Sinh viên gửi yêu cầu đặt mượn từ Cổng thông tin (tối đa 3 cuốn). Thủ thư kiểm tra thẻ và phê duyệt cấp sách.
                    </p>
                </div>
                <a asp-area="Admin" asp-controller="Borrow" asp-action="Index"
                   class="w-full py-2.5 px-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold shadow text-center transition-colors flex items-center justify-center gap-1.5">
                    <i data-lucide="check-square" class="w-4 h-4"></i> Mở Quầy Duyệt Mượn
                </a>
            </div>

            <!-- BƯỚC 2 -->
            <div class="p-5 rounded-2xl border border-indigo-200 bg-indigo-50/50 hover:bg-indigo-50 transition-all flex flex-col justify-between space-y-4">
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="w-8 h-8 rounded-xl bg-indigo-600 text-white font-black text-sm flex items-center justify-center shadow-sm">2</span>
                        <span class="text-[10px] font-bold text-indigo-700 uppercase">Khổ A5/A4</span>
                    </div>
                    <h4 class="font-bold text-sm text-indigo-950">In Phiếu Mượn & Giao Sách</h4>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        In phiếu mượn kèm mã vạch, thông tin độc giả, số kiểm soát cuốn sách và chữ ký cam kết bồi thường khi làm hỏng/mất.
                    </p>
                </div>
                <a asp-area="Admin" asp-controller="Borrow" asp-action="Index"
                   class="w-full py-2.5 px-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold shadow text-center transition-colors flex items-center justify-center gap-1.5">
                    <i data-lucide="printer" class="w-4 h-4"></i> Danh Sách In Phiếu
                </a>
            </div>

            <!-- BƯỚC 3 -->
            <div class="p-5 rounded-2xl border border-emerald-200 bg-emerald-50/50 hover:bg-emerald-50 transition-all flex flex-col justify-between space-y-4">
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="w-8 h-8 rounded-xl bg-emerald-600 text-white font-black text-sm flex items-center justify-center shadow-sm">3</span>
                        <span class="text-[10px] font-bold text-emerald-700 uppercase">Quầy trả sách</span>
                    </div>
                    <h4 class="font-bold text-sm text-emerald-950">Quầy Tiếp Nhận & Kiểm Kê</h4>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Sinh viên mang sách đến trả. Thủ thư tra cứu mã phiếu/số thẻ, kiểm tra nguyên vẹn hay rách/hỏng trang để xác nhận vào kho.
                    </p>
                </div>
                <a asp-area="Admin" asp-controller="Borrow" asp-action="Return"
                   class="w-full py-2.5 px-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold shadow text-center transition-colors flex items-center justify-center gap-1.5">
                    <i data-lucide="scan-barcode" class="w-4 h-4"></i> Quầy Tiếp Nhận Trả
                </a>
            </div>

            <!-- BƯỚC 4 -->
            <div class="p-5 rounded-2xl border border-amber-200 bg-amber-50/50 hover:bg-amber-50 transition-all flex flex-col justify-between space-y-4">
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="w-8 h-8 rounded-xl bg-amber-600 text-white font-black text-sm flex items-center justify-center shadow-sm">4</span>
                        <span class="text-[10px] font-bold text-amber-700 uppercase">Mở khóa thẻ</span>
                    </div>
                    <h4 class="font-bold text-sm text-amber-950">Thanh Toán Bồi Thường Tại Chỗ</h4>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Áp dụng mức phí chuẩn khi sách hỏng (50k) hoặc mất (100k). Thu tiền tại quầy, xuất biên lai và mở khóa thẻ thư viện ngay lập tức.
                    </p>
                </div>
                <a asp-area="Admin" asp-controller="Borrow" asp-action="Payment"
                   class="w-full py-2.5 px-3 bg-amber-600 hover:bg-amber-700 text-white rounded-xl text-xs font-bold shadow text-center transition-colors flex items-center justify-center gap-1.5">
                    <i data-lucide="credit-card" class="w-4 h-4"></i> Quầy Thu Phí Bồi Thường
                </a>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script>
        async function approveFast(id, code) {
            if (!confirm(`Xác nhận duyệt và cấp sách cho phiếu mượn ${code}?`)) return;
            try {
                const res = await fetch(`/Admin/Borrow/ApproveBorrowRequest?requestId=${id}`, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await res.json();
                if (data.success) {
                    if (typeof window.showAppToast === 'function') {
                        window.showAppToast('success', 'Thành công', data.message);
                    } else {
                        alert(data.message);
                    }
                    setTimeout(() => location.reload(), 600);
                } else {
                    if (typeof window.showAppToast === 'function') {
                        window.showAppToast('error', 'Lỗi duyệt', data.message);
                    } else {
                        alert(data.message);
                    }
                }
            } catch (err) {
                alert('Lỗi kết nối khi gửi yêu cầu phê duyệt: ' + err.message);
            }
        }

        async function rejectFast(id, code) {
            const reason = prompt(`Nhập lý do từ chối phiếu mượn ${code}:`, 'Sách đang bảo trì kho / Hạn mức thẻ độc giả không đủ');
            if (reason === null) return;
            try {
                const res = await fetch(`/Admin/Borrow/RejectBorrowRequest?requestId=${id}&reason=${encodeURIComponent(reason)}`, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await res.json();
                if (data.success) {
                    if (typeof window.showAppToast === 'function') {
                        window.showAppToast('success', 'Đã từ chối', data.message);
                    } else {
                        alert(data.message);
                    }
                    setTimeout(() => location.reload(), 600);
                } else {
                    if (typeof window.showAppToast === 'function') {
                        window.showAppToast('error', 'Lỗi từ chối', data.message);
                    } else {
                        alert(data.message);
                    }
                }
            } catch (err) {
                alert('Lỗi kết nối khi gửi yêu cầu từ chối: ' + err.message);
            }
        }

        // ================= CHART.JS INITIALIZATION =================
        document.addEventListener('DOMContentLoaded', () => {
            // Line Chart: Trend
            const trendCtx = document.getElementById('borrowTrendChart')?.getContext('2d');
            if (trendCtx) {
                new Chart(trendCtx, {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyLabels)),
                        datasets: [
                            {
                                label: 'Lượt Mượn',
                                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyBorrowCounts)),
                                borderColor: '#1e3a8a',
                                backgroundColor: 'rgba(30, 58, 138, 0.08)',
                                fill: true,
                                tension: 0.35,
                                borderWidth: 2.5,
                                pointBackgroundColor: '#1e3a8a',
                                pointRadius: 4
                            },
                            {
                                label: 'Lượt Trả',
                                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyReturnCounts)),
                                borderColor: '#10b981',
                                backgroundColor: 'transparent',
                                borderDash: [5, 5],
                                tension: 0.35,
                                borderWidth: 2,
                                pointBackgroundColor: '#10b981',
                                pointRadius: 3
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: '#f1f5f9' },
                                ticks: { font: { family: 'Inter', size: 11 } }
                            },
                            x: {
                                grid: { display: false },
                                ticks: { font: { family: 'Inter', size: 11 } }
                            }
                        }
                    }
                });
            }

            // Doughnut Chart: Categories Distribution
            const catCtx = document.getElementById('categoryDistributionChart')?.getContext('2d');
            if (catCtx) {
                new Chart(catCtx, {
                    type: 'doughnut',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryLabels)),
                        datasets: [{
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryBookCounts)),
                            backgroundColor: ['#2563eb', '#10b981', '#f59e0b', '#6366f1', '#ec4899'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }
        });
    </script>
}
