@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject BOOK.Data.ApplicationDbContext DbContext
@{
    var currentUserName = User.Identity?.Name ?? "Quản Trị Hệ Thống";
    var currentUserEmail = User.FindFirst(ClaimTypes.Email)?.Value ?? (User.Identity?.Name != null && User.Identity.Name.Contains("@") ? User.Identity.Name : "admin@huflit.edu.vn");
    var isRealAdmin = User.IsInRole("Admin");
    var currentUserRole = isRealAdmin ? "👑 Quản Trị Hệ Thống" : "🛡️ Thủ Thư HUFLIT";
    var roleShort = isRealAdmin ? "AD" : "TT";

    var pendingBorrowsCount = await DbContext.PhieuMuons.CountAsync(p => p.TrangThai == "Chờ duyệt");
    var overdueBorrowsCount = await DbContext.PhieuMuons.CountAsync(p => p.TrangThai == "Đang mượn" && p.HanTra < DateTime.Today);
}
<!DOCTYPE html>
<html lang="vi" class="h-full bg-slate-100" id="htmlRoot">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Trị Hệ Thống Thư Viện HUFLIT</title>

    <!-- Google Fonts: Be Vietnam Pro & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        navy: {
                            50: '#f0f4f9', 100: '#e1e9f2', 200: '#c3d3e6', 300: '#95b3d4',
                            400: '#618ec0', 500: '#3d6ea8', 600: '#2d568c', 700: '#254572',
                            800: '#1e3a8a', 900: '#0f1e40', 950: '#091226',
                        }
                    },
                    fontFamily: {
                        sans: ['"Be Vietnam Pro"', 'Inter', 'sans-serif'],
                    }
                }
            }
        };
    </script>
    <!-- Lucide Icons & Chart.js -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .sidebar-transition { transition: width 0.25s ease-in-out; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="min-h-full flex flex-col font-sans text-slate-800 antialiased bg-slate-100 selection:bg-navy-800 selection:text-white">

    <div class="flex h-screen overflow-hidden">

        <!-- ================= SIDEBAR CỐ ĐỊNH & THU GỌN ================= -->
        <aside id="adminSidebar" 
               class="sidebar-transition w-64 bg-navy-950 text-slate-300 flex flex-col flex-shrink-0 border-r border-navy-900 select-none z-30 fixed inset-y-0 left-0 lg:static lg:translate-x-0 -translate-x-full">
            
            <!-- Brand & Logo -->
            <div class="h-20 flex items-center justify-between px-5 bg-navy-900 border-b border-navy-800">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="flex items-center gap-3 group overflow-hidden">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 text-white flex items-center justify-center shadow flex-shrink-0">
                        <i data-lucide="book-open-check" class="w-5 h-5 text-amber-400"></i>
                    </div>
                    <div class="sidebar-text whitespace-nowrap">
                        <span class="block text-[10px] uppercase font-bold tracking-widest text-blue-300">Cổng Quản Trị</span>
                        <h2 class="text-base font-black text-white tracking-tight leading-none">SMART<span class="text-amber-400">LIB</span></h2>
                    </div>
                </a>

                <!-- Mobile Close Button -->
                <button onclick="toggleSidebar()" class="lg:hidden text-slate-400 hover:text-white p-1">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Current User Badge (Sidebar) -->
            <div class="p-3 mx-3 my-3 bg-navy-900/60 rounded-2xl border border-navy-800/80 flex items-center gap-3 overflow-hidden">
                <div class="w-9 h-9 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-xs flex-shrink-0 shadow">
                    @roleShort
                </div>
                <div class="sidebar-text overflow-hidden">
                    <p class="text-xs font-bold text-white truncate">@currentUserName</p>
                    <span class="inline-block text-[10px] font-semibold text-emerald-400">@currentUserRole</span>
                </div>
            </div>

            <!-- Sidebar Navigation Groups -->
            <nav class="flex-1 px-3 space-y-5 overflow-y-auto text-xs py-2">
                
                <!-- Group 0: Tổng quan -->
                <div>
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index" 
                       class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-bold transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "bg-navy-800 text-white shadow-sm" : "text-slate-400 hover:text-white hover:bg-navy-900")">
                        <i data-lucide="layout-dashboard" class="w-4 h-4 text-amber-400 flex-shrink-0"></i>
                        <span class="sidebar-text">Tổng Quan Dashboard</span>
                    </a>
                </div>

                <!-- Group 1: Nghiệp vụ Mượn - Trả -->
                <div class="space-y-1">
                    <div class="sidebar-text text-[10px] font-bold text-slate-500 uppercase tracking-wider px-3 pb-1">
                        Nghiệp Vụ Mượn - Trả
                    </div>

                    <a asp-area="Admin" asp-controller="Borrow" asp-action="Index" 
                       class="flex items-center justify-between px-3 py-2 rounded-xl font-medium transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Borrow" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "bg-navy-800 text-white" : "text-slate-300 hover:text-white hover:bg-navy-900")">
                        <div class="flex items-center gap-3">
                            <i data-lucide="arrow-left-right" class="w-4 h-4 text-blue-400 flex-shrink-0"></i>
                            <span class="sidebar-text">Quản lý Mượn / Trả</span>
                        </div>
                        @if (pendingBorrowsCount > 0)
                        {
                            <span class="sidebar-text px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-400/20 text-amber-300 border border-amber-400/30">
                                @pendingBorrowsCount
                            </span>
                        }
                    </a>

                    <a asp-area="Admin" asp-controller="Borrow" asp-action="Return" 
                       class="flex items-center gap-3 px-3 py-2 rounded-xl font-medium transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Borrow" && ViewContext.RouteData.Values["Action"]?.ToString() == "Return" ? "bg-navy-800 text-white" : "text-slate-400 hover:text-white hover:bg-navy-900")">
                        <i data-lucide="scan-barcode" class="w-4 h-4 text-emerald-400 flex-shrink-0"></i>
                        <span class="sidebar-text">Quầy Thu Hồi & Đánh Giá</span>
                    </a>

                    <a asp-area="Admin" asp-controller="Borrow" asp-action="Create" 
                       class="flex items-center gap-3 px-3 py-2 rounded-xl font-medium transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Borrow" && ViewContext.RouteData.Values["Action"]?.ToString() == "Create" ? "bg-navy-800 text-white" : "text-slate-400 hover:text-white hover:bg-navy-900")">
                        <i data-lucide="plus-circle" class="w-4 h-4 text-teal-400 flex-shrink-0"></i>
                        <span class="sidebar-text">Lập Phiếu Mượn Trực Tiếp</span>
                    </a>

                    <a asp-area="Admin" asp-controller="Borrow" asp-action="Index" 
                       class="flex items-center justify-between px-3 py-2 rounded-xl text-slate-400 hover:text-white hover:bg-navy-900 transition-colors">
                        <div class="flex items-center gap-3">
                            <i data-lucide="alert-triangle" class="w-4 h-4 text-rose-400 flex-shrink-0"></i>
                            <span class="sidebar-text">Xử Lý Quá Hạn & Phạt</span>
                        </div>
                        @if (overdueBorrowsCount > 0)
                        {
                            <span class="sidebar-text px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-500/20 text-rose-300 border border-rose-500/30">
                                @overdueBorrowsCount
                            </span>
                        }
                    </a>
                </div>

                <!-- Group 2: Quản lý Kho sách & Dữ liệu -->
                <div class="space-y-1">
                    <div class="sidebar-text text-[10px] font-bold text-slate-500 uppercase tracking-wider px-3 pb-1">
                        Quản Lý Dữ Liệu
                    </div>

                    <a asp-area="Admin" asp-controller="Book" asp-action="Index" 
                       class="flex items-center gap-3 px-3 py-2 rounded-xl font-medium transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Book" ? "bg-navy-800 text-white" : "text-slate-400 hover:text-white hover:bg-navy-900")">
                        <i data-lucide="book-copy" class="w-4 h-4 text-teal-400 flex-shrink-0"></i>
                        <span class="sidebar-text">Kho Sách & Đầu Sách</span>
                    </a>

                    <a asp-area="Admin" asp-controller="Category" asp-action="Index" 
                       class="flex items-center gap-3 px-3 py-2 rounded-xl font-medium transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Category" ? "bg-navy-800 text-white" : "text-slate-400 hover:text-white hover:bg-navy-900")">
                        <i data-lucide="tags" class="w-4 h-4 text-indigo-400 flex-shrink-0"></i>
                        <span class="sidebar-text">Thể Loại & Chuyên Ngành</span>
                    </a>

                    <a asp-area="Admin" asp-controller="Publisher" asp-action="Index" 
                       class="flex items-center gap-3 px-3 py-2 rounded-xl font-medium transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Publisher" ? "bg-navy-800 text-white" : "text-slate-400 hover:text-white hover:bg-navy-900")">
                        <i data-lucide="building-2" class="w-4 h-4 text-cyan-400 flex-shrink-0"></i>
                        <span class="sidebar-text">Tác Giả & Nhà Xuất Bản</span>
                    </a>
                </div>

                <!-- Group 3: Báo cáo & Thống kê -->
                <div class="space-y-1">
                    <div class="sidebar-text text-[10px] font-bold text-slate-500 uppercase tracking-wider px-3 pb-1">
                        Báo Cáo & Phân Tích
                    </div>

                    <a asp-area="Admin" asp-controller="Report" asp-action="Index" 
                       class="flex items-center gap-3 px-3 py-2 rounded-xl font-medium transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Report" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "bg-navy-800 text-white" : "text-slate-400 hover:text-white hover:bg-navy-900")">
                        <i data-lucide="bar-chart-3" class="w-4 h-4 text-emerald-400 flex-shrink-0"></i>
                        <span class="sidebar-text">Báo Cáo & Top Sách Mượn</span>
                    </a>

                    <a asp-area="Admin" asp-controller="Report" asp-action="DamagedLostBooks" 
                       class="flex items-center gap-3 px-3 py-2 rounded-xl font-medium transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Report" && ViewContext.RouteData.Values["Action"]?.ToString() == "DamagedLostBooks" ? "bg-navy-800 text-white" : "text-slate-400 hover:text-white hover:bg-navy-900")">
                        <i data-lucide="alert-octagon" class="w-4 h-4 text-rose-400 flex-shrink-0"></i>
                        <span class="sidebar-text">Sách Hỏng & Thanh Lý</span>
                    </a>
                </div>

                <!-- Group 4: Hệ thống & Tài khoản (Chỉ dành cho Admin tối cao) -->
                @if (isRealAdmin)
                {
                    <div class="space-y-1">
                        <div class="sidebar-text text-[10px] font-bold text-slate-500 uppercase tracking-wider px-3 pb-1">
                            Hệ Thống & Tài Khoản
                        </div>

                        <a asp-area="Admin" asp-controller="User" asp-action="Index" 
                           class="flex items-center gap-3 px-3 py-2 rounded-xl font-medium transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "User" ? "bg-navy-800 text-white" : "text-slate-400 hover:text-white hover:bg-navy-900")">
                            <i data-lucide="users" class="w-4 h-4 text-pink-400 flex-shrink-0"></i>
                            <span class="sidebar-text">Người Dùng & Phân Quyền</span>
                        </a>

                        <a asp-area="Admin" asp-controller="Report" asp-action="Settings" 
                           class="flex items-center gap-3 px-3 py-2 rounded-xl font-medium transition-colors @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Report" && ViewContext.RouteData.Values["Action"]?.ToString() == "Settings" ? "bg-navy-800 text-white" : "text-slate-400 hover:text-white hover:bg-navy-900")">
                            <i data-lucide="sliders" class="w-4 h-4 text-slate-400 flex-shrink-0"></i>
                            <span class="sidebar-text">Cấu Hình Quy Định Mượn</span>
                        </a>
                    </div>
                }
            </nav>

            <!-- Bottom Action -->
            <div class="p-3 border-t border-navy-900">
                <a asp-area="" asp-controller="Home" asp-action="Index" 
                   class="flex items-center justify-center gap-2 w-full py-2.5 px-3 bg-navy-900 hover:bg-navy-800 text-slate-300 hover:text-white rounded-xl text-xs font-semibold transition-colors">
                    <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                    <span class="sidebar-text">Xem Cổng Công Cộng</span>
                </a>
            </div>
        </aside>

        <!-- Sidebar Overlay on Mobile -->
        <div id="sidebarOverlay" onclick="toggleSidebar()" class="hidden fixed inset-0 bg-navy-950/60 backdrop-blur-sm z-20 lg:hidden"></div>

        <!-- ================= MAIN CONTENT WRAPPER ================= -->
        <div class="flex-1 flex flex-col overflow-hidden min-w-0">
            
            <!-- TOPBAR -->
            <header class="h-20 bg-white border-b border-slate-200 px-4 sm:px-8 flex items-center justify-between flex-shrink-0 shadow-sm z-10">
                
                <!-- Left: Sidebar Toggle -->
                <div class="flex items-center gap-4">
                    <button onclick="toggleSidebar()" class="p-2 text-slate-600 hover:text-navy-800 hover:bg-slate-100 rounded-xl transition-colors">
                        <i data-lucide="menu" class="w-5 h-5"></i>
                    </button>
                </div>

                <!-- Right: Utilities & Profile Dropdown -->
                <div class="flex items-center gap-3">
                    
                    <!-- Notification Bell with Dropdown -->
                    <div class="relative">
                        <button onclick="toggleNotificationDropdown()" class="relative p-2 text-slate-500 hover:text-navy-800 hover:bg-slate-100 rounded-xl transition-colors">
                            <i data-lucide="bell" class="w-5 h-5"></i>
                            <span id="adminNotifDot" class="absolute top-1.5 right-1.5 w-2 h-2 bg-rose-500 rounded-full animate-pulse"></span>
                        </button>

                        <!-- Notification Dropdown Panel -->
                        <div id="notificationDropdown" class="hidden absolute right-0 mt-3 w-80 bg-white rounded-2xl shadow-xl border border-slate-200 py-2 z-50">
                            <div class="px-4 py-2 border-b border-slate-100 flex items-center justify-between">
                                <span class="text-xs font-bold text-slate-900">Thông báo mới</span>
                                <button type="button" onclick="markAdminNotificationsAsRead()" class="text-[10px] font-semibold text-blue-600 hover:underline">Đánh dấu đã đọc</button>
                            </div>
                            <div class="divide-y divide-slate-100 max-h-64 overflow-y-auto text-xs">
                                <a asp-area="Admin" asp-controller="Borrow" asp-action="Index" onclick="markAdminNotificationsAsRead()" class="block p-3 hover:bg-slate-50 transition-colors">
                                    <p class="font-bold text-slate-800">Yêu cầu mượn trực tuyến</p>
                                    <p class="text-[11px] text-slate-500">@(pendingBorrowsCount > 0 ? $"Có {pendingBorrowsCount} yêu cầu mượn đang chờ duyệt." : "Không có yêu cầu mượn mới nào.")</p>
                                    <span class="text-[10px] text-slate-400 mt-1 block">Hệ thống</span>
                                </a>
                                <a asp-area="Admin" asp-controller="Borrow" asp-action="Index" onclick="markAdminNotificationsAsRead()" class="block p-3 hover:bg-slate-50 transition-colors">
                                    <p class="font-bold text-rose-600">Cảnh báo quá hạn</p>
                                    <p class="text-[11px] text-slate-500">@(overdueBorrowsCount > 0 ? $"Có {overdueBorrowsCount} phiếu mượn quá hạn cần thu hồi." : "Hiện không có tài liệu nào trễ hạn.")</p>
                                    <span class="text-[10px] text-slate-400 mt-1 block">Hệ thống</span>
                                </a>
                            </div>
                            <div class="p-2 border-t border-slate-100 text-center">
                                <a asp-area="Admin" asp-controller="Borrow" asp-action="Index" onclick="markAdminNotificationsAsRead()" class="text-xs font-bold text-navy-800 hover:underline">
                                    Xem tất cả trong Quản lý mượn trả
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- User Profile & Logout Dropdown -->
                    <div class="relative pl-3 border-l border-slate-200">
                        <button onclick="toggleProfileDropdown()" class="flex items-center gap-3 p-1 rounded-xl hover:bg-slate-50 transition-colors">
                            <div class="w-9 h-9 rounded-xl bg-navy-800 text-amber-300 font-bold flex items-center justify-center text-xs border border-slate-200 shadow-sm flex-shrink-0">
                                @roleShort
                            </div>
                            <div class="hidden sm:block text-left">
                                <p class="text-xs font-bold text-slate-900 leading-tight">@currentUserName</p>
                                <span class="text-[10px] font-semibold text-blue-600">@currentUserRole</span>
                            </div>
                            <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 hidden sm:block"></i>
                        </button>

                        <!-- Profile Dropdown Menu: Chỉ còn Đăng xuất -->
                        <div id="profileDropdown" class="hidden absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-xl border border-slate-200 py-2 z-50 text-xs">
                            <div class="px-4 py-2 border-b border-slate-100">
                                <p class="font-bold text-slate-900 truncate">@currentUserName</p>
                                <p class="text-slate-400 text-[11px] truncate">@currentUserEmail</p>
                                <span class="inline-block mt-1 text-[10px] font-bold text-emerald-600">@currentUserRole</span>
                            </div>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="w-full pt-1">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="w-full flex items-center gap-2 px-4 py-2.5 text-rose-600 hover:bg-rose-50 text-left font-bold transition-colors">
                                    <i data-lucide="log-out" class="w-4 h-4"></i> Đăng xuất
                                </button>
                            </form>
                        </div>
                    </div>

                </div>
            </header>

            <!-- MAIN DYNAMIC CONTENT -->
            <main class="flex-1 overflow-y-auto p-4 sm:p-8 bg-slate-100">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- SCRIPT LOGIC (SIDEBAR COLLAPSE, DROPDOWNS, THEME) -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const isDark = document.documentElement.classList.contains('dark');
            const icon = document.getElementById('themeIcon');
            if (icon) {
                icon.setAttribute('data-lucide', isDark ? 'sun' : 'moon');
            }
            if (window.lucide) {
                lucide.createIcons();
            }
        });

        function toggleSidebar() {
            const sidebar = document.getElementById('adminSidebar');
            const overlay = document.getElementById('sidebarOverlay');
            if (window.innerWidth < 1024) {
                sidebar.classList.toggle('-translate-x-full');
                overlay.classList.toggle('hidden');
            } else {
                // Desktop collapse logic
                sidebar.classList.toggle('w-64');
                sidebar.classList.toggle('w-20');
                document.querySelectorAll('.sidebar-text').forEach(el => el.classList.toggle('hidden'));
            }
        }

        function toggleNotificationDropdown() {
            document.getElementById('notificationDropdown')?.classList.toggle('hidden');
            document.getElementById('profileDropdown')?.classList.add('hidden');
        }

        function toggleProfileDropdown() {
            document.getElementById('profileDropdown')?.classList.toggle('hidden');
            document.getElementById('notificationDropdown')?.classList.add('hidden');
        }

        // Close dropdowns on outside click
        window.addEventListener('click', (e) => {
            if (!e.target.closest('#notificationDropdown') && !e.target.closest('button[onclick="toggleNotificationDropdown()"]')) {
                document.getElementById('notificationDropdown')?.classList.add('hidden');
            }
            if (!e.target.closest('#profileDropdown') && !e.target.closest('button[onclick="toggleProfileDropdown()"]')) {
                document.getElementById('profileDropdown')?.classList.add('hidden');
            }
        });

        function markAdminNotificationsAsRead() {
            const dot = document.getElementById('adminNotifDot');
            if (dot) dot.classList.add('hidden');
            localStorage.setItem('admin_notif_read', 'true');
            if (window.showAppToast) {
                window.showAppToast('success', 'Thông Báo', 'Đã đánh dấu đã đọc tất cả thông báo!');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            if (localStorage.getItem('admin_notif_read') === 'true') {
                const dot = document.getElementById('adminNotifDot');
                if (dot) dot.classList.add('hidden');
            }
        });

        // ================= GLOBAL APP MODAL & TOAST HELPERS FOR ADMIN =================
        window.showAppModal = function(options) {
            return new Promise((resolve) => {
                const overlay = document.getElementById('appModalOverlay');
                const box = document.getElementById('appModalBox');
                const iconWrapper = document.getElementById('appModalIconWrapper');
                const icon = document.getElementById('appModalIcon');
                const title = document.getElementById('appModalTitle');
                const msg = document.getElementById('appModalMessage');
                const confirmBtn = document.getElementById('appModalConfirmBtn');
                const cancelBtn = document.getElementById('appModalCancelBtn');

                if (!overlay || !box) {
                    resolve(true);
                    return;
                }

                const type = options.type || 'info';
                title.innerText = options.title || 'Thông Báo Hệ Thống';
                if (options.html) {
                    msg.innerHTML = options.html;
                } else {
                    msg.innerText = options.message || '';
                }

                if (type === 'success') {
                    iconWrapper.className = 'w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center flex-shrink-0';
                    icon.setAttribute('data-lucide', 'check-circle-2');
                    confirmBtn.className = 'px-5 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded-xl text-xs font-bold shadow-md transition-all';
                } else if (type === 'error' || type === 'danger') {
                    iconWrapper.className = 'w-12 h-12 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center flex-shrink-0';
                    icon.setAttribute('data-lucide', 'alert-circle');
                    confirmBtn.className = 'px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-xs font-bold shadow-md transition-all';
                } else if (type === 'warning') {
                    iconWrapper.className = 'w-12 h-12 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center flex-shrink-0';
                    icon.setAttribute('data-lucide', 'alert-triangle');
                    confirmBtn.className = 'px-5 py-2.5 bg-amber-600 hover:bg-amber-700 text-white rounded-xl text-xs font-bold shadow-md transition-all';
                } else {
                    iconWrapper.className = 'w-12 h-12 rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center flex-shrink-0';
                    icon.setAttribute('data-lucide', 'info');
                    confirmBtn.className = 'px-5 py-2.5 bg-navy-800 hover:bg-navy-900 text-white rounded-xl text-xs font-bold shadow-md transition-all';
                }

                confirmBtn.innerText = options.confirmText || 'Đồng ý';

                if (options.cancelText || type === 'confirm') {
                    cancelBtn.classList.remove('hidden');
                    cancelBtn.innerText = options.cancelText || 'Hủy bỏ';
                } else {
                    cancelBtn.classList.add('hidden');
                }

                overlay.classList.remove('hidden');
                setTimeout(() => {
                    box.classList.remove('scale-95', 'opacity-0');
                    box.classList.add('scale-100', 'opacity-100');
                }, 10);
                if (window.lucide) lucide.createIcons();

                const cleanup = (result) => {
                    box.classList.remove('scale-100', 'opacity-100');
                    box.classList.add('scale-95', 'opacity-0');
                    setTimeout(() => {
                        overlay.classList.add('hidden');
                    }, 150);
                    confirmBtn.onclick = null;
                    cancelBtn.onclick = null;
                    resolve(result);
                };

                confirmBtn.onclick = () => cleanup(true);
                cancelBtn.onclick = () => cleanup(false);
            });
        };

        window.showAppConfirm = function(message, title = 'Xác Nhận Thao Tác') {
            return window.showAppModal({
                title: title,
                message: message,
                type: 'confirm',
                confirmText: 'Đồng ý',
                cancelText: 'Hủy bỏ'
            });
        };

        window.showAppAlert = function(message, title = 'Thông Báo') {
            return window.showAppModal({
                title: title,
                message: message,
                type: 'info',
                confirmText: 'Đã hiểu'
            });
        };

        window.showAppToast = function(type, title, message) {
            const container = document.getElementById('adminToastContainer');
            if (!container) return;

            const isSuccess = type === 'success';
            const isWarn = type === 'warning';
            let colorClass = isSuccess ? 'text-emerald-800 bg-emerald-50 border-emerald-200' : 
                             (isWarn ? 'text-amber-800 bg-amber-50 border-amber-200' : 'text-rose-800 bg-rose-50 border-rose-200');
            let iconName = isSuccess ? 'check-circle-2' : (isWarn ? 'alert-triangle' : 'alert-circle');
            let iconColor = isSuccess ? 'text-emerald-600' : (isWarn ? 'text-amber-600' : 'text-rose-600');

            const toast = document.createElement('div');
            toast.className = `pointer-events-auto flex items-center gap-3 p-4 text-xs sm:text-sm ${colorClass} border rounded-xl shadow-lg transition-all transform duration-300`;
            toast.innerHTML = `
                <i data-lucide="${iconName}" class="w-5 h-5 ${iconColor} flex-shrink-0"></i>
                <div>
                    <p class="font-semibold">${title}</p>
                    <p class="text-xs mt-0.5">${message}</p>
                </div>
            `;
            container.appendChild(toast);
            if (window.lucide) lucide.createIcons();

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-x-full');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        };
    </script>

    <!-- ================= GLOBAL REUSABLE APP MODAL FOR ADMIN ================= -->
    <div id="appModalOverlay" class="fixed inset-0 z-[9999] hidden bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-4 transition-all duration-200">
        <div id="appModalBox" class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-7 shadow-2xl border border-slate-200 relative transform transition-all duration-200 scale-95 opacity-0">
            <div class="flex items-start gap-4">
                <div id="appModalIconWrapper" class="w-12 h-12 rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center flex-shrink-0">
                    <i id="appModalIcon" data-lucide="info" class="w-6 h-6"></i>
                </div>
                <div class="space-y-1.5 flex-1">
                    <h3 id="appModalTitle" class="text-base font-extrabold text-slate-900 leading-snug">Thông Báo</h3>
                    <div id="appModalMessage" class="text-xs text-slate-600 leading-relaxed whitespace-pre-line"></div>
                </div>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-end gap-2.5">
                <button type="button" id="appModalCancelBtn" class="hidden px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 transition-colors">
                    Hủy bỏ
                </button>
                <button type="button" id="appModalConfirmBtn" class="px-5 py-2.5 bg-navy-800 hover:bg-navy-900 text-white rounded-xl text-xs font-bold shadow-md hover:shadow-lg transition-all">
                    Đồng ý
                </button>
            </div>
        </div>
    </div>

    <!-- ADMIN TOAST CONTAINER -->
    <div id="adminToastContainer" class="fixed top-20 right-5 z-50 flex flex-col gap-3 pointer-events-none">
        @if (TempData["Success"] != null)
        {
            <div class="pointer-events-auto flex items-center gap-3 p-4 text-xs sm:text-sm text-emerald-800 bg-emerald-50 border border-emerald-200 rounded-xl shadow-lg">
                <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-600 flex-shrink-0"></i>
                <div>
                    <p class="font-semibold">Thành công!</p>
                    <p class="text-emerald-700 text-xs">@TempData["Success"]</p>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="pointer-events-auto flex items-center gap-3 p-4 text-xs sm:text-sm text-rose-800 bg-rose-50 border border-rose-200 rounded-xl shadow-lg">
                <i data-lucide="alert-circle" class="w-5 h-5 text-rose-600 flex-shrink-0"></i>
                <div>
                    <p class="font-semibold">Có lỗi xảy ra</p>
                    <p class="text-rose-700 text-xs">@TempData["Error"]</p>
                </div>
            </div>
        }
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
