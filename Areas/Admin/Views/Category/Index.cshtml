@model List<BOOK.Models.Entities.TheLoai>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản Lý Thể Loại";
}
<div class="space-y-4 text-xs">
    <form asp-area="Admin" asp-controller="Category" asp-action="Save" method="post" class="flex gap-2 bg-white p-4 rounded-2xl border border-slate-200">
        <input type="hidden" name="id" value="0" />
        <input name="name" required placeholder="Tên thể loại mới" class="flex-1 p-2.5 bg-slate-50 border border-slate-200 rounded-xl" />
        <button type="submit" class="px-4 py-2 bg-emerald-600 text-white rounded-xl font-bold">Thêm</button>
    </form>
    <div class="bg-white rounded-2xl border border-slate-200 divide-y divide-slate-100">
        @foreach (var t in Model)
        {
            <div class="flex items-center gap-2 p-3">
                <form asp-area="Admin" asp-controller="Category" asp-action="Save" method="post" class="flex flex-1 gap-2">
                    <input type="hidden" name="id" value="@t.MaTheLoai" />
                    <input name="name" value="@t.TenTheLoai" class="flex-1 p-2 bg-slate-50 border border-slate-200 rounded-xl" />
                    <button type="submit" class="px-3 py-1.5 bg-navy-800 text-white rounded-xl font-bold">Lưu</button>
                </form>
                <span class="w-16 text-slate-500">@t.Sachs.Count sách</span>
                <form asp-area="Admin" asp-controller="Category" asp-action="Delete" asp-route-id="@t.MaTheLoai" method="post" onsubmit="return confirm('Xóa thể loại này?')">
                    <button type="submit" class="px-3 py-1.5 bg-rose-50 text-rose-700 rounded-xl font-bold">Xóa</button>
                </form>
            </div>
        }
    </div>
</div>