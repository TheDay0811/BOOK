@model BOOK.Models.ViewModels.BookTitleManageViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản Lý Bản Sao Sách - " + Model.Title;
}

<div class="space-y-6">

    <!-- BREADCRUMBS & TIÊU ĐỀ -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <nav class="flex items-center gap-2 text-xs text-slate-500 mb-1">
                <a asp-area="Admin" asp-controller="Book" asp-action="Index" class="hover:underline">Kho sách</a>
                <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-slate-400"></i>
                <span class="text-navy-800 font-bold">Chi tiết bản sao vật lý</span>
            </nav>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">Quản Lý Bản Sao & Số Kiểm Soát</h1>
        </div>

        <div class="flex items-center gap-2">
            <button onclick="openAddCopyModal()" 
                    class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold shadow transition-all flex items-center gap-2">
                <i data-lucide="plus-circle" class="w-4 h-4"></i> Thêm Bản Sao (Sinh Số KS Tiếp Theo)
            </button>
            <a asp-area="Admin" asp-controller="Book" asp-action="Index" 
               class="px-3.5 py-2.5 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-xl text-xs font-semibold transition-colors">
                Quay lại
            </a>
        </div>
    </div>

    <!-- KHUNG THÔNG TIN TỰA SÁCH & THỐNG KÊ TỔNG QUAN -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
            <div class="lg:col-span-8 flex gap-5 items-start">
                <img src="@(string.IsNullOrEmpty(Model.CoverImageUrl) ? "/uploads/books/default-book.svg" : Model.CoverImageUrl)" 
                     alt="@Model.Title" class="w-20 h-28 object-cover rounded-xl border border-slate-200 shadow-sm flex-shrink-0" 
                     onerror="this.onerror=null; this.src='/uploads/books/default-book.svg';" />
                <div class="space-y-1.5">
                    <div class="flex items-center gap-2">
                        <span class="px-2.5 py-0.5 rounded text-[11px] font-bold bg-navy-100 text-navy-800">Mã sách: @Model.BookCode</span>
                        <span class="text-xs text-slate-500 font-mono">ISBN: @Model.BookCode</span>
                    </div>
                    <h3 class="text-lg font-black text-slate-900 leading-tight">@Model.Title</h3>
                    <p class="text-xs text-slate-600">Tác giả: <strong>@Model.Author</strong> • NXB: @Model.PublisherName (@Model.PublishYear) • <strong>@Model.PageCount trang</strong></p>
                    <p class="text-xs text-blue-600 font-medium">Chuyên ngành: @Model.CategoryName</p>
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="text-xs text-slate-500 leading-relaxed pt-1">@Model.Description</p>
                    }
                </div>
            </div>

            <!-- THỐNG KÊ THEO 4 TRẠNG THÁI NGHIỆP VỤ -->
            <div class="lg:col-span-4 grid grid-cols-2 gap-2 text-center text-xs">
                <div class="p-2.5 bg-emerald-50 rounded-xl border border-emerald-200">
                    <span class="text-slate-500 block text-[10px] uppercase font-bold">Khả dụng [Còn]</span>
                    <strong class="text-emerald-700 text-base font-black">@Model.AvailableCopies</strong> / @Model.TotalCopies cuốn
                </div>
                <div class="p-2.5 bg-blue-50 rounded-xl border border-blue-200">
                    <span class="text-slate-500 block text-[10px] uppercase font-bold">[Cho mượn]</span>
                    <strong class="text-blue-700 text-base font-black">@Model.BorrowedCopies</strong> cuốn
                </div>
                <div class="p-2.5 bg-amber-50 rounded-xl border border-amber-200">
                    <span class="text-slate-500 block text-[10px] uppercase font-bold">[Hỏng]</span>
                    <strong class="text-amber-700 text-base font-black">@Model.DamagedCopies</strong> cuốn
                </div>
                <div class="p-2.5 bg-rose-50 rounded-xl border border-rose-200">
                    <span class="text-slate-500 block text-[10px] uppercase font-bold">[Mất]</span>
                    <strong class="text-rose-700 text-base font-black">@Model.LostCopies</strong> cuốn
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG DANH SÁCH CUỐN SÁCH VẬT LÝ (THEO SỐ KIỂM SOÁT) -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden space-y-4 p-6">
        <div class="flex justify-between items-center pb-2 border-b border-slate-100">
            <div>
                <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <i data-lucide="barcode" class="w-5 h-5 text-navy-800"></i>
                    Danh Sách Các Cuốn Sách Vật Lý (Theo Số Kiểm Soát)
                </h3>
                <p class="text-xs text-slate-400">Mỗi cuốn sách trong thư viện được gán một "Số kiểm soát" duy nhất để theo dõi lưu thông.</p>
            </div>
            <span class="text-xs text-slate-500">Tổng cộng: <strong>@Model.Copies.Count</strong> bản sao</span>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-slate-200">
            <table class="w-full text-left text-xs text-slate-600">
                <thead class="bg-slate-50 text-slate-500 uppercase font-bold border-b border-slate-200">
                    <tr>
                        <th class="py-3 px-4">Số Kiểm Soát</th>
                        <th class="py-3 px-4">Mã Sách</th>
                        <th class="py-3 px-4">Tình Trạng Nghiệp Vụ</th>
                        <th class="py-3 px-4">Vị Trí Kệ Lưu Trữ</th>
                        <th class="py-3 px-4">Ghi Chú Chi Tiết</th>
                        <th class="py-3 px-4 text-right">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                    @foreach (var copy in Model.Copies)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <!-- Số kiểm soát -->
                            <td class="py-3.5 px-4 font-mono font-black text-sm text-navy-800">
                                @copy.ControlNumber
                            </td>
                            <td class="py-3.5 px-4 font-mono text-slate-500">
                                @Model.BookCode
                            </td>
                            <!-- Trạng thái 4 loại: Còn, Cho mượn, Mất, Hỏng -->
                            <td class="py-3.5 px-4">
                                @if (copy.Status == "Còn")
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Còn sách
                                    </span>
                                }
                                else if (copy.Status == "Cho mượn")
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800 border border-blue-200">
                                        <i data-lucide="clock" class="w-3 h-3 text-blue-600"></i> Cho mượn
                                    </span>
                                }
                                else if (copy.Status == "Hỏng")
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200">
                                        <i data-lucide="alert-triangle" class="w-3 h-3 text-amber-600"></i> Hỏng
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-800 border border-rose-200">
                                        <i data-lucide="x-circle" class="w-3 h-3 text-rose-600"></i> Mất
                                    </span>
                                }
                            </td>
                            <td class="py-3.5 px-4 font-medium text-slate-700">
                                @copy.ShelfLocation
                            </td>
                            <td class="py-3.5 px-4 text-slate-600 italic">
                                "@copy.Notes"
                            </td>
                            <td class="py-3.5 px-4 text-right">
                                <div class="flex items-center justify-end gap-1.5">
                                    <button onclick="openUpdateStatusModal(@copy.Id, '@copy.ControlNumber', '@copy.Status', '@copy.Notes')"
                                            class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-navy-800 rounded-lg font-bold transition-colors">
                                        Đổi tình trạng
                                    </button>
                                    <form asp-area="Admin" asp-controller="Book" asp-action="Liquidate" method="post" onsubmit="return confirm('Đề xuất thanh lý cuốn @copy.ControlNumber?')">
                                        <input type="hidden" name="bookId" value="@Model.BookId" />
                                        <input type="hidden" name="copyId" value="@copy.Id" />
                                        <button type="submit" class="px-2.5 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 rounded-lg font-bold">Thanh lý</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ================= QUẢN LÝ NỘI DUNG ĐỌC THỬ (TRANG MẪU) ================= -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden space-y-4 p-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100">
            <div>
                <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                    <i data-lucide="book-open" class="w-5 h-5 text-amber-500"></i>
                    Quản Lý Nội Dung Đọc Thử (@Model.PreviewPages.Count trang mẫu)
                </h3>
                <p class="text-xs text-slate-400">Các trang trích đoạn hiển thị cho sinh viên khi bấm "Đọc thử" trên cổng tra cứu.</p>
            </div>
            <div class="flex items-center gap-2">
                <a asp-area="" asp-controller="Book" asp-action="Details" asp-route-id="@Model.BookId" asp-route-preview="1" target="_blank"
                   class="px-3.5 py-2 bg-amber-100 hover:bg-amber-200 text-amber-950 rounded-xl text-xs font-bold transition-colors flex items-center gap-1.5">
                    <i data-lucide="external-link" class="w-3.5 h-3.5"></i> Xem thử ngoài cổng
                </a>
                <button type="button" onclick="openAddPreviewModal()"
                        class="px-4 py-2 bg-navy-800 hover:bg-navy-900 text-white rounded-xl text-xs font-bold shadow transition-colors flex items-center gap-1.5">
                    <i data-lucide="plus-circle" class="w-4 h-4 text-amber-400"></i> Thêm Trang Đọc Thử
                </button>
            </div>
        </div>

        @if (Model.PreviewPages != null && Model.PreviewPages.Any())
        {
            <div class="space-y-3">
                @foreach (var p in Model.PreviewPages)
                {
                    <div class="p-4 rounded-2xl border border-slate-200 bg-slate-50/70 flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                        <div class="space-y-1 flex-1 min-w-0">
                            <div class="flex items-center gap-2">
                                <span class="px-2 py-0.5 rounded-lg text-[11px] font-mono font-black bg-navy-100 text-navy-900">Trang @p.PageNumber</span>
                                <h4 class="font-bold text-sm text-slate-900 truncate">@p.Title</h4>
                            </div>
                            <p class="text-xs text-slate-600 line-clamp-2 whitespace-pre-line">@p.Content</p>
                        </div>
                        <div class="flex items-center gap-1.5 flex-shrink-0">
                            <button type="button"
                                    data-page-id="@p.Id"
                                    data-page-number="@p.PageNumber"
                                    data-page-title="@p.Title"
                                    data-page-content="@p.Content"
                                    onclick="openEditPreviewModalFromBtn(this)"
                                    class="px-3 py-1.5 bg-white hover:bg-blue-50 text-blue-700 border border-slate-200 rounded-xl text-xs font-bold transition-colors">
                                Sửa
                            </button>
                            <form asp-area="Admin" asp-controller="Book" asp-action="DeletePreviewPage" method="post" onsubmit="return confirm('Xóa trang đọc thử số @p.PageNumber?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bookId" value="@Model.BookId" />
                                <input type="hidden" name="pageId" value="@p.Id" />
                                <button type="submit" class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 rounded-xl text-xs font-bold transition-colors">
                                    Xóa
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="p-8 text-center bg-slate-50 rounded-2xl border border-dashed border-slate-200 text-xs text-slate-500">
                Chưa có trang đọc thử tùy chỉnh. Hệ thống đang hiển thị 3 trang tóm tắt tự động; hãy bấm <strong>"Thêm Trang Đọc Thử"</strong> để nhập nội dung trích đoạn thật.
            </div>
        }
    </div>

</div>

<!-- ================= MODAL THÊM BẢN SAO (SINH SỐ KIỂM SOÁT TIẾP THEO) ================= -->
<div id="addCopyModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-navy-950/60 backdrop-blur-sm">
    <div class="bg-white rounded-3xl shadow-2xl border border-slate-200 max-w-md w-full overflow-hidden">
        <div class="bg-navy-900 text-white p-5 flex items-center justify-between">
            <h3 class="font-bold text-base flex items-center gap-2">
                <i data-lucide="plus-circle" class="w-5 h-5 text-emerald-400"></i> Thêm Bản Sao Mới Vào Kho
            </h3>
            <button onclick="closeAddCopyModal()" class="text-slate-400 hover:text-white p-1">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <form asp-area="Admin" asp-controller="Book" asp-action="AddCopy" method="post" class="p-6 space-y-4 text-xs">
            @Html.AntiForgeryToken()
            <input type="hidden" name="bookId" value="@Model.BookId" />
            @{
                var nextCtrlNum = Model.Copies
                    .Select(c => int.TryParse(c.ControlNumber, out var n) ? n : 0)
                    .DefaultIfEmpty(0)
                    .Max() + 1;
            }
            <div>
                <label class="block font-bold text-slate-700 uppercase mb-1">Số kiểm soát tự sinh tiếp theo</label>
                <input type="text" readonly value="@nextCtrlNum.ToString("D3")" class="w-full p-2.5 bg-slate-100 border border-slate-200 rounded-xl font-mono font-black text-navy-800 text-sm" />
                <span class="text-[10px] text-slate-400">Tự động tăng tuần tự theo tựa sách này.</span>
            </div>

            <div>
                <label class="block font-bold text-slate-700 uppercase mb-1">Trạng thái khởi tạo</label>
                <input type="text" readonly value="Còn" class="w-full p-2.5 bg-emerald-50 border border-emerald-200 rounded-xl font-bold text-emerald-800" />
            </div>

            <div>
                <label class="block font-bold text-slate-700 uppercase mb-1">Vị trí kệ sách</label>
                <input type="text" value="Tầng 2 - Dãy B4 - Kệ 03" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl" />
            </div>

            <div>
                <label class="block font-bold text-slate-700 uppercase mb-1">Ghi chú tình trạng</label>
                <input type="text" name="notes" value="Sách nhập mới 100%, nguyên vẹn" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl" />
            </div>

            <div class="pt-3 border-t flex justify-end gap-2">
                <button type="button" onclick="closeAddCopyModal()" class="px-4 py-2 text-slate-600 font-semibold hover:bg-slate-100 rounded-xl">Hủy</button>
                <button type="submit" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-bold shadow">
                    Lưu Bản Sao
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ================= MODAL CẬP NHẬT TÌNH TRẠNG CUỐN SÁCH ================= -->
<div id="updateStatusModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-navy-950/60 backdrop-blur-sm">
    <div class="bg-white rounded-3xl shadow-2xl border border-slate-200 max-w-md w-full overflow-hidden">
        <div class="bg-navy-900 text-white p-5 flex items-center justify-between">
            <h3 class="font-bold text-base flex items-center gap-2">
                <i data-lucide="edit-3" class="w-5 h-5 text-amber-400"></i> Cập Nhật Tình Trạng Bản Sao
            </h3>
            <button onclick="closeUpdateStatusModal()" class="text-slate-400 hover:text-white p-1">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <form asp-area="Admin" asp-controller="Book" asp-action="UpdateCopy" method="post" class="p-6 space-y-4 text-xs">
            <input type="hidden" name="bookId" value="@Model.BookId" />
            <input type="hidden" name="copyId" id="modalCopyId" />
            <div>
                <label class="block font-bold text-slate-700 uppercase mb-1">Số kiểm soát</label>
                <input type="text" id="modalControlNumber" readonly class="w-full p-2.5 bg-slate-100 border border-slate-200 rounded-xl font-mono font-bold" />
            </div>

            <div>
                <label class="block font-bold text-slate-700 uppercase mb-1">Tình trạng cuốn sách</label>
                <select id="modalStatusSelect" name="tinhTrang" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl font-bold">
                    <option value="Còn">Còn (Sẵn sàng trong kho)</option>
                    <option value="Cho mượn">Cho mượn (Đang có độc giả giữ)</option>
                    <option value="Hỏng">Hỏng (Chờ sửa chữa / thanh lý)</option>
                    <option value="Mất">Mất (Chờ bồi thường / thanh lý)</option>
                </select>
            </div>

            <div>
                <label class="block font-bold text-slate-700 uppercase mb-1">Ghi chú tình trạng</label>
                <textarea id="modalNotesText" name="ghiChu" rows="3" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl"></textarea>
            </div>

            <div class="pt-3 border-t flex justify-end gap-2">
                <button type="button" onclick="closeUpdateStatusModal()" class="px-4 py-2 font-semibold text-slate-600 hover:bg-slate-100 rounded-xl">Hủy</button>
                <button type="submit" class="px-5 py-2 bg-navy-800 hover:bg-navy-900 text-white rounded-xl font-bold">
                    Cập Nhật
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ================= MODAL THÊM / SỬA TRANG ĐỌC THỬ ================= -->
<div id="previewPageModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-navy-950/60 backdrop-blur-sm">
    <div class="bg-white rounded-3xl shadow-2xl border border-slate-200 max-w-xl w-full overflow-hidden">
        <div class="bg-navy-900 text-white p-5 flex items-center justify-between">
            <h3 id="previewModalTitle" class="font-bold text-base flex items-center gap-2">
                <i data-lucide="book-open" class="w-5 h-5 text-amber-400"></i> Thêm Trang Đọc Thử
            </h3>
            <button type="button" onclick="closePreviewModal()" class="text-slate-400 hover:text-white p-1">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <form id="previewPageForm" asp-area="Admin" asp-controller="Book" asp-action="AddPreviewPage" method="post" class="p-6 space-y-4 text-xs">
            @Html.AntiForgeryToken()
            <input type="hidden" name="bookId" value="@Model.BookId" />
            <input type="hidden" name="pageId" id="previewPageIdInput" value="0" />

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                    <label class="block font-bold text-slate-700 uppercase mb-1">Số trang <span class="text-rose-500">*</span></label>
                    <input type="number" name="pageNumber" id="previewPageNumberInput" min="1" max="999" value="@((Model.PreviewPages?.Any() == true ? Model.PreviewPages.Max(p => p.PageNumber) : 0) + 1)" required
                           class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl font-mono font-bold" />
                </div>
                <div class="sm:col-span-2">
                    <label class="block font-bold text-slate-700 uppercase mb-1">Tiêu đề trang / chương <span class="text-rose-500">*</span></label>
                    <input type="text" name="title" id="previewPageTitleInput" required placeholder="VD: Chương 1 - Giới thiệu..."
                           class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl" />
                </div>
            </div>

            <div>
                <label class="block font-bold text-slate-700 uppercase mb-1">Nội dung trích đoạn <span class="text-rose-500">*</span></label>
                <textarea name="content" id="previewPageContentInput" rows="7" required placeholder="Nhập nội dung trích đoạn của trang đọc thử..."
                          class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl leading-relaxed"></textarea>
            </div>

            <div class="pt-3 border-t flex justify-end gap-2">
                <button type="button" onclick="closePreviewModal()" class="px-4 py-2 font-semibold text-slate-600 hover:bg-slate-100 rounded-xl">Hủy</button>
                <button type="submit" class="px-5 py-2 bg-navy-800 hover:bg-navy-900 text-white rounded-xl font-bold shadow">Lưu Trang Đọc Thử</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openAddCopyModal() { document.getElementById('addCopyModal')?.classList.remove('hidden'); lucide.createIcons(); }
        function closeAddCopyModal() { document.getElementById('addCopyModal')?.classList.add('hidden'); }

        function openUpdateStatusModal(copyId, ctrlNum, status, notes) {
            document.getElementById('modalCopyId').value = copyId;
            document.getElementById('modalControlNumber').value = ctrlNum;
            document.getElementById('modalStatusSelect').value = status;
            document.getElementById('modalNotesText').value = notes;
            document.getElementById('updateStatusModal')?.classList.remove('hidden');
            lucide.createIcons();
        }
        function closeUpdateStatusModal() { document.getElementById('updateStatusModal')?.classList.add('hidden'); }

        function openAddPreviewModal() {
            const form = document.getElementById('previewPageForm');
            form.action = '/Admin/Book/AddPreviewPage';
            document.getElementById('previewModalTitle').innerHTML = '<i data-lucide="book-open" class="w-5 h-5 text-amber-400"></i> Thêm Trang Đọc Thử';
            document.getElementById('previewPageIdInput').value = '0';
            document.getElementById('previewPageNumberInput').value = '@((Model.PreviewPages?.Any() == true ? Model.PreviewPages.Max(p => p.PageNumber) : 0) + 1)';
            document.getElementById('previewPageTitleInput').value = '';
            document.getElementById('previewPageContentInput').value = '';
            document.getElementById('previewPageModal')?.classList.remove('hidden');
            lucide.createIcons();
        }

        function openEditPreviewModalFromBtn(btn) {
            const form = document.getElementById('previewPageForm');
            form.action = '/Admin/Book/UpdatePreviewPage';
            document.getElementById('previewModalTitle').innerHTML = '<i data-lucide="edit-3" class="w-5 h-5 text-amber-400"></i> Chỉnh Sửa Trang Đọc Thử';
            document.getElementById('previewPageIdInput').value = btn.getAttribute('data-page-id') || '0';
            document.getElementById('previewPageNumberInput').value = btn.getAttribute('data-page-number') || '1';
            document.getElementById('previewPageTitleInput').value = btn.getAttribute('data-page-title') || '';
            document.getElementById('previewPageContentInput').value = btn.getAttribute('data-page-content') || '';
            document.getElementById('previewPageModal')?.classList.remove('hidden');
            lucide.createIcons();
        }

        function closePreviewModal() {
            document.getElementById('previewPageModal')?.classList.add('hidden');
        }
    </script>
}
